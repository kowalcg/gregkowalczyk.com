---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<section class="pb-12 pt-8 md:pb-16 md:pt-12">
  <div class="mx-auto max-w-6xl px-6">
    <h1
      class="mb-4 text-3xl font-bold md:text-4xl lg:text-5xl"
      style="font-family: 'Outfit', sans-serif; color: #fafaf9; letter-spacing: -0.03em; line-height: 1.06; text-wrap: balance;"
    >
      <span class="comment-prefix" style="font-size: 0.8em;">// </span>{title}
    </h1>
    {subtitle && (
      <p
        class="max-w-2xl text-base leading-relaxed md:text-lg"
        style="font-family: 'Outfit', sans-serif; color: #8b8b8a;"
      >
        {subtitle}
      </p>
    )}
  </div>
</section>
