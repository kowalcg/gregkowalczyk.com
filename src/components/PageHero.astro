---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<section class="pb-12 pt-8 md:pb-16 md:pt-12">
  <div class="mx-auto max-w-6xl px-6">
    {/* The "// " is drawn by CSS, so search engines read the heading itself, not "// About". */}
    <h1
      class="ph-h1 mb-4 text-3xl font-bold md:text-4xl lg:text-5xl"
      style="font-family: 'Outfit', sans-serif; color: var(--fg); letter-spacing: -0.03em; line-height: 1.06; text-wrap: balance;"
    >
      {title}
    </h1>
    {subtitle && (
      <p
        class="max-w-2xl text-base leading-relaxed md:text-lg"
        style="font-family: 'Outfit', sans-serif; color: var(--muted);"
      >
        {subtitle}
      </p>
    )}
  </div>
</section>

<style>
  .ph-h1::before { content: "// "; color: var(--accent-text); font-size: .8em; font-family: var(--font-mono); font-weight: 400; letter-spacing: -.05em; }
</style>
