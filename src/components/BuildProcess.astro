---
// "How it works" — the homepage services section. Four steps scroll on the
// left; a live schematic on the right shows what happens to the work at each
// step: dots (orders, emails, bookings) pile up at the manual constraint in
// steps 1–2, then flow through the built system in 3–4. Prices and promises
// come from OfferLadder.astro on /services/ — keep the two in sync.
// If the visitor drew a blueprint (BlueprintBuilder.astro), the schematic
// relabels its sources and system with their answers ('gk-blueprint' event).

interface Props { showBuilds?: boolean; lead?: string }
const { showBuilds = true, lead = 'From blueprint to a system' } = Astro.props;

const steps = [
  {
    n: '01', key: 'Find the constraint', offer: 'Free 15-minute assessment', price: 'No cost',
    body: 'Every business has one place where work piles up. On a short call we find yours. I name the tool that fixes it and give you a first step you can take without me.',
    points: ['One bottleneck, examined properly', 'One tool named, with what it costs', 'One first step you can take yourself'],
    cta: { label: 'Book the free 15 minutes', href: '/contact/' },
  },
  {
    n: '02', key: 'Map it and price it', offer: 'The AI Assessment', price: '$1,000, credited against a build',
    body: 'I watch how the work really happens, map every repeated process and rank each one by what it costs you. You get a written build plan with real tools and real costs.',
    points: ['Every process mapped and ranked by return', 'A written plan with tools and costs', 'Yours to keep, whether or not I build it'],
    cta: { label: 'Start with the assessment', href: '/contact/' },
  },
  {
    n: '03', key: 'Build the system', offer: 'Fixed-price build', price: 'You own everything',
    body: 'I connect the tools you already use, add AI where reading and writing eat your time, and add checks so you approve what matters. I write the code and deploy it.',
    points: ['Connects to your existing tools', 'AI reads, sorts and drafts', 'No licence, no lock-in'],
    cta: null,
  },
  {
    n: '04', key: 'Run it, then hand it over', offer: 'Handover or monthly', price: 'Training included, always',
    body: 'The system reports back to you. I document it and train your team to run it without me, or stay on monthly and we keep finding and killing manual work.',
    points: ['Documentation and training included', 'Reports that come to you', 'Then on to the next constraint'],
    cta: { label: 'Talk about a build', href: '/contact/' },
  },
];

const builds = [
  { name: 'Custom AI tools', line: 'Dashboards, content systems and internal tools you own.', preset: 'reports', biz: '' },
  { name: 'E-commerce AI systems', line: 'Product content, inventory and marketplace work, tested on my own brands.', preset: 'reports', biz: 'ecom' },
  { name: 'Marketing automation', line: 'Email, social and ad workflows that run without you.', preset: 'admin', biz: '' },
  { name: 'Digital launch and growth', line: 'Going online: store setup, local search and AI-answer visibility.', preset: 'found', biz: '' },
  { name: 'AI for race directors and events', line: 'The system behind the Bronte Harbour Classic, for your event.', href: '/race-directors/' },
  { name: 'Product research and validation', line: 'Engineering analysis and market data before you buy inventory.', href: '/services/' },
];
---

<section class="bpx" id="how-it-works" aria-labelledby="bpx-heading" data-bpx>
  <div class="bpx-head">
    <div class="bpx-eyebrow">How it works</div>
    <h2 id="bpx-heading">{lead} <em>you own.</em></h2>
    <p>Four steps. Watch what happens to the work at each one.</p>
  </div>

  <div class="bpx-grid">
    <ol class="bpx-steps" data-steps>
      <span class="bpx-rail" aria-hidden="true"><i data-rail></i></span>
      {steps.map((s, i) => (
        <li class={`bpx-step${i === 0 ? ' on' : ''}`} data-step={i + 1} data-cap={s.body} id={`how-step-${i + 1}`}>
          <div class="bpx-num">{s.n}</div>
          <div class="bpx-body">
            <div class="bpx-offer"><span>{s.offer}</span><b>{s.price}</b></div>
            <h3>{s.key}</h3>
            <p class="bpx-p">{s.body}</p>
            <ul>{s.points.map((pt) => <li>{pt}</li>)}</ul>
            {i === 0 && <p class="bpx-yours" data-yours hidden></p>}
            {s.cta && <a class="bpx-cta" href={s.cta.href}>{s.cta.label} →</a>}
          </div>
        </li>
      ))}
    </ol>

    <figure class="bpx-fig">
      <svg viewBox="0 0 1000 640" data-stage="1" role="img" aria-labelledby="bpx-svg-title bpx-svg-desc">
        <title id="bpx-svg-title">How the work flows through your business</title>
        <desc id="bpx-svg-desc">Work items arrive from your tools. By hand, they queue at one person. After the build, they flow through connect, AI, check and approve steps to finished outputs, and you get a daily brief.</desc>
        <defs>
          <pattern id="bpx-g1" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="#101417" stroke-width="1" /></pattern>
          <pattern id="bpx-g2" width="100" height="100" patternUnits="userSpaceOnUse"><rect width="100" height="100" fill="url(#bpx-g1)" /><path d="M100 0H0V100" fill="none" stroke="#182026" stroke-width="1" /></pattern>
          <filter id="bpx-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
        </defs>
        <rect width="1000" height="640" fill="#050607" />
        <rect width="1000" height="640" fill="url(#bpx-g2)" />
        <rect x="12" y="12" width="976" height="616" fill="none" stroke="#232a30" />
        <path d="M12 32V12H32M968 628H988V608" fill="none" stroke="#f06000" stroke-width="2" />
        <text x="40" y="52" class="t-mono t-muted">SCHEMATIC · WHERE YOUR WORK GOES</text>
        <text x="960" y="52" text-anchor="end" class="t-mono t-accent" data-stage-label>STAGE 01 / 04 · FIND THE CONSTRAINT</text>

        {/* sources */}
        <text x="40" y="126" class="t-mono t-muted">WORK COMES IN FROM</text>
        {[170, 260, 350, 440].map((y, i) => (
          <g class="node" data-src={i}>
            <rect x="40" y={y - 27} width="170" height="54" rx="8" />
            <circle cx="66" cy={y} r="9" class="ic" /><circle cx="66" cy={y} r="3" class="icf" />
            <text x="86" y={y + 5} class="t-label" data-src-label={i}>{['Orders', 'Emails', 'Bookings', 'Spreadsheets'][i]}</text>
          </g>
        ))}
        {[170, 260, 350, 440].map((y, i) => (
          <path id={`bpx-src${i}`} class="wire" d={`M210 ${y} C 244 ${y}, 232 305, 262 305`} />
        ))}

        {/* the lane where work waits */}
        <path id="bpx-lane" class="rail" d="M262 305 H470" />
        <path class="rail-edge" d="M262 295 H470 M262 315 H470" />
        <g class="s12">
          <path class="ln accent" pathLength="1" d="M272 282 V274 H464 V282" />
          <text x="368" y="264" text-anchor="middle" class="t-mono t-accent">THE CONSTRAINT</text>
        </g>
        <text x="466" y="340" text-anchor="end" class="t-mono"><tspan data-queue>0</tspan><tspan class="t-muted"> WAITING</tspan></text>

        {/* the middle: by hand, or the system */}
        <rect x="470" y="150" width="300" height="310" rx="12" class="block block-hand s12f" />
        <rect x="470" y="150" width="300" height="310" rx="12" class="block block-sys s34f" />
        <path id="bpx-mid" class="wire-hidden" d="M470 305 H770" />

        <g class="s12">
          <text x="492" y="180" class="t-mono t-muted">BY HAND</text>
          <circle cx="615" cy="262" r="17" class="ln-w" />
          <path class="ln-w" d="M580 330 Q580 292 615 292 Q650 292 650 330" />
          <path class="ln-w" d="M548 336 H690" />
          <rect x="660" y="318" width="26" height="14" class="ln-w" /><rect x="664" y="311" width="26" height="7" class="ln-w" />
          <circle cx="720" cy="200" r="17" class="ln-w" />
          <line x1="720" y1="200" x2="720" y2="189" class="ln-w hand" data-clock-m />
          <line x1="720" y1="200" x2="727" y2="200" class="ln-w hand" data-clock-h />
          <text x="492" y="434" class="t-small">You, one item at a time.</text>
        </g>

        <g class="s34">
          <text x="492" y="180" class="t-mono t-accent">YOUR SYSTEM</text>
          <text x="492" y="208" class="t-title" data-sys>Built around your tools</text>
          {[520, 590, 660, 730].map((cx, i) => (
            <g class="mod" data-mod={i}>
              <rect x={cx - 28} y="277" width="56" height="56" rx="8" />
              <text x={cx} y="352" text-anchor="middle" class="t-mono t-tiny">{['CONNECT', 'AI', 'CHECK', 'APPROVE'][i]}</text>
            </g>
          ))}
          <path class="ic-w" d="M513 296 V288 M527 296 V288 M507 296 H533 V303 A13 13 0 0 1 507 303 Z M520 316 V323" />
          <path class="ic-a" d="M590 288 Q592 303 607 305 Q592 307 590 322 Q588 307 573 305 Q588 303 590 288 Z" />
          <path class="ic-w" d="M648 305 L656 313 L672 297" />
          <circle cx="730" cy="297" r="6" class="ic-w" /><path class="ic-w" d="M718 318 Q730 304 742 318" />
          <path class="ln accent" pathLength="1" d="M730 277 V246 H700" />
          <text x="696" y="250" text-anchor="end" class="t-small">You stay in control</text>
          <text x="492" y="410" class="t-small">Connects to the tools you already use.</text>
          <text x="492" y="434" class="t-small">Runs on your accounts. You own the code.</text>
        </g>

        {/* outputs */}
        <text x="830" y="160" class="t-mono t-muted">DONE</text>
        <text x="970" y="160" text-anchor="end" class="t-mono"><tspan data-rate>0</tspan><tspan class="t-muted"> / MIN</tspan></text>
        {[200, 305, 410].map((y, i) => (
          <g class="node" data-out={i}>
            <rect x="830" y={y - 25} width="140" height="50" rx="8" />
            <path class="icf-line" d={`M846 ${y} l5 5 l10 -10`} />
            <text x="870" y={y + 5} class="t-label">{['Replies sent', 'Reports ready', 'Records saved'][i]}</text>
          </g>
        ))}
        {[200, 305, 410].map((y, i) => (
          <path id={`bpx-out${i}`} class="wire" d={`M770 305 C 802 305, 798 ${y}, 830 ${y}`} />
        ))}

        {/* step 2: ranked and planned */}
        <g class="s2">
          <rect x="530" y="112" width="180" height="26" rx="13" class="pill" />
          <text x="620" y="130" text-anchor="middle" class="t-mono t-dark">#1 · COSTS THE MOST</text>
          <path class="ln accent" pathLength="1" d="M620 138 V150" />
          <rect x="164" y="248" width="36" height="22" rx="11" class="pill" /><text x="182" y="263" text-anchor="middle" class="t-mono t-dark">#2</text>
          <rect x="164" y="428" width="36" height="22" rx="11" class="pill" /><text x="182" y="443" text-anchor="middle" class="t-mono t-dark">#3</text>
          <path class="dash" d="M620 460 V482" />
          <rect x="470" y="482" width="300" height="118" rx="10" class="plan" />
          <text x="490" y="508" class="t-mono t-accent">BUILD PLAN · YOURS TO KEEP</text>
          {['Tools to connect, and what they cost', 'Where AI reads and writes', 'Fixed price and timeline'].map((t, i) => (
            <g><rect x="490" y={524 + i * 24} width="11" height="11" class="ln-w" /><path class="ln accent" pathLength="1" d={`M492 ${530 + i * 24} l3 3 l5 -6`} /><text x="512" y={534 + i * 24} class="t-small">{t}</text></g>
          ))}
        </g>

        {/* step 4: reports back, handed over, next constraint */}
        <path id="bpx-brief" class="wire s4w" d="M770 305 C 800 305, 796 520, 830 520" />
        <g class="s4">
          <rect x="830" y="494" width="140" height="52" rx="8" class="brief" />
          <path class="ic-a" d="M846 510 h18 v14 h-18 z M846 510 l9 7 l9 -7" />
          <text x="872" y="525" class="t-label">Daily brief</text>
          <rect x="470" y="494" width="300" height="52" rx="8" class="docs" />
          <text x="490" y="525" class="t-label">Docs + training · your team runs it</text>
          <path id="bpx-loop" class="dash dash-accent" d="M900 546 V590 H125 V475" />
          <path class="ln accent" pathLength="1" d="M118 484 L125 472 L132 484" />
          <text x="300" y="582" class="t-mono t-accent">NEXT CONSTRAINT</text>
        </g>

        <g class="legend">
          <circle cx="46" cy="611" r="4.5" fill="#fff" />
          <text x="58" y="615" class="t-small t-muted">= one piece of work: an order, an email, a booking</text>
        </g>
        <g data-particles></g>
        <g class="static-q" data-static-q>
          {Array.from({ length: 12 }, (_, k) => <circle cx={462 - k * 9.5} cy="305" r="4.2" fill="#f06000" />)}
        </g>
      </svg>
      <figcaption class="bpx-cap" data-cap>{steps[0].body}</figcaption>
    </figure>
  </div>

  {showBuilds && <div class="bpx-builds">
    <div class="bpx-eyebrow">What I build with this process</div>
    <ul>
      {builds.map((b) => (
        <li>
          {b.href
            ? <a href={b.href}><b>{b.name}</b><span>{b.line}</span><i>Details →</i></a>
            : <a href="#blueprint" data-preset={b.preset} data-biz={b.biz}><b>{b.name}</b><span>{b.line}</span><i>Draw yours ↑</i></a>}
        </li>
      ))}
    </ul>
  </div>}
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-bpx]');
  if (root) {
    const NS = 'http://www.w3.org/2000/svg';
    const svg = root.querySelector('svg')!;
    const q = <T extends Element = SVGElement>(s: string) => svg.querySelector<T>(s)!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const LABELS = ['Find the constraint', 'Map it and price it', 'Build the system', 'Run it, then hand it over'];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const CAPS = steps.map((st) => st.dataset.cap || '');
    const rail = root.querySelector<HTMLElement>('[data-rail]')!;
    const cap = root.querySelector<HTMLElement>('[data-cap]')!;
    const stageLabel = q('[data-stage-label]');
    let stage = 1;

    function setStage(n: number) {
      if (n === stage) return;
      stage = n;
      svg.dataset.stage = String(n);
      steps.forEach((s, i) => s.classList.toggle('on', i === n - 1));
      rail.style.height = ((n - 1) / (steps.length - 1)) * 100 + '%';
      stageLabel.textContent = `STAGE 0${n} / 04 · ${LABELS[n - 1].toUpperCase()}`;
      cap.textContent = CAPS[n - 1];
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setStage(Number((e.target as HTMLElement).dataset.step)); });
    }, { rootMargin: '-45% 0px -45% 0px' });
    steps.forEach((s) => io.observe(s));

    // Personalise from the blueprint builder above, once the visitor has used it.
    const DEFAULT_SRC = ['Orders', 'Emails', 'Bookings', 'Spreadsheets'];
    const yours = root.querySelector<HTMLElement>('[data-yours]');
    window.addEventListener('gk-blueprint', (e) => {
      const d = (e as CustomEvent).detail as { touched: boolean; tools: string[]; system: string; noun: string };
      if (!d.touched) return;
      const tools = d.tools.slice(0, 4);
      for (let i = 0; i < 4; i++) q(`[data-src-label="${i}"]`).textContent = tools[i] || DEFAULT_SRC[i];
      q('[data-sys]').textContent = d.system.length > 26 ? d.system.slice(0, 25) + '…' : d.system;
      if (yours) { yours.hidden = false; yours.textContent = `Bring your blueprint: a ${d.system.toLowerCase()} for ${d.noun}. The schematic now uses your tools.`; }
    });

    // ---- the flow simulation -------------------------------------------------
    const staticQ = q('[data-static-q]');
    if (reduce) {
      staticQ.style.display = '';
    } else {
      staticQ.style.display = 'none';
      const layer = q('[data-particles]');
      const P = (id: string) => q<SVGPathElement>('#' + id);
      const src = [0, 1, 2, 3].map((i) => P(`bpx-src${i}`));
      const outs = [0, 1, 2].map((i) => P(`bpx-out${i}`));
      const mid = P('bpx-mid'), brief = P('bpx-brief'), loop = P('bpx-loop');
      const lenOf = new Map<SVGPathElement, number>();
      [...src, ...outs, mid, brief, loop].forEach((p) => lenOf.set(p, p.getTotalLength()));
      const srcNodes = [...svg.querySelectorAll('[data-src]')].filter((n) => n.tagName === 'g');
      const outNodes = [...svg.querySelectorAll('[data-out]')];
      const mods = [...svg.querySelectorAll('[data-mod]')];
      const qCount = q('[data-queue]'), rateEl = q('[data-rate]');
      const clockM = q('[data-clock-m]'), clockH = q('[data-clock-h]');

      type Dot = { el: SVGCircleElement; path?: SVGPathElement; t: number; speed: number; kind: string; x: number };
      const moving: Dot[] = [];
      const queue: Dot[] = [];
      const doneAt: number[] = [];
      const ENTRY = 462, SLOT = 9.5, CAP = 20, LANE_Y = 305;
      let arriving = 0, spawnAcc = 0, procAcc = 0, clock = 0;

      const mk = (fill: string) => {
        const c = document.createElementNS(NS, 'circle') as SVGCircleElement;
        c.setAttribute('r', '4.2'); c.setAttribute('fill', fill);
        layer.appendChild(c); return c;
      };
      const pulse = (n: Element) => { n.classList.add('hit'); setTimeout(() => n.classList.remove('hit'), 240); };
      const at = (d: Dot, x: number, y: number) => { d.el.setAttribute('cx', x.toFixed(1)); d.el.setAttribute('cy', y.toFixed(1)); };

      function spawn() {
        if (queue.length + arriving >= CAP) return;
        const i = Math.floor(Math.random() * 4);
        moving.push({ el: mk('#ffffff'), path: src[i], t: 0, speed: 0.17, kind: 'src', x: 0 });
        arriving++;
        pulse(srcNodes[i]);
      }

      function tick(dt: number, now: number) {
        const manual = stage <= 2;
        spawnAcc += dt;
        if (spawnAcc > 360) { spawnAcc = 0; spawn(); }

        const hot = [0, 0, 0, 0];
        for (let k = moving.length - 1; k >= 0; k--) {
          const d = moving[k];
          const L = lenOf.get(d.path!)!;
          d.t += d.speed * dt;
          const pt = d.path!.getPointAtLength(Math.min(d.t, L));
          at(d, pt.x, pt.y);
          if (d.kind === 'mid' && !manual) {
            const idx = Math.floor((pt.x - 492) / 70);
            if (idx >= 0 && idx < 4 && Math.abs(pt.x - (520 + idx * 70)) < 28) hot[idx] = 1;
          }
          if (d.t < L) continue;
          moving.splice(k, 1);
          if (d.kind === 'src') {
            arriving--; d.kind = 'lane'; d.x = 262; d.el.setAttribute('fill', '#f06000'); queue.push(d);
          } else if (d.kind === 'mid') {
            const toBrief = stage === 4 && Math.random() < 0.22;
            d.kind = toBrief ? 'brief' : 'out';
            d.path = toBrief ? brief : outs[Math.floor(Math.random() * 3)];
            d.t = 0; d.speed = 0.24; d.el.setAttribute('fill', '#ffffff');
            moving.push(d);
          } else if (d.kind === 'brief') {
            d.kind = 'loop'; d.path = loop; d.t = 0; d.speed = 0.5; d.el.setAttribute('fill', '#f06000'); moving.push(d);
          } else {
            if (d.kind === 'out') { pulse(outNodes[outs.indexOf(d.path!)]); doneAt.push(now); }
            d.el.remove();
          }
        }
        mods.forEach((m, i) => m.classList.toggle('hit', !!hot[i]));

        queue.forEach((d, k) => {
          const target = ENTRY - k * SLOT;
          d.x += (target - d.x) * Math.min(1, dt * 0.012);
          at(d, d.x, LANE_Y);
        });
        procAcc += dt;
        const interval = manual ? 1150 : 150;
        if (procAcc >= interval && queue.length && queue[0].x > ENTRY - 3) {
          procAcc = 0;
          const d = queue.shift()!;
          d.kind = 'mid'; d.path = mid; d.t = 0; d.speed = manual ? 0.28 : 0.55;
          d.el.setAttribute('fill', manual ? '#ffffff' : '#f06000');
          d.el.setAttribute('filter', manual ? '' : 'url(#bpx-glow)');
          moving.push(d);
        }

        while (doneAt.length && now - doneAt[0] > 10000) doneAt.shift();
        qCount.textContent = String(queue.length);
        rateEl.textContent = String(doneAt.length * 6);
        if (manual) {
          clock += dt;
          clockM.setAttribute('transform', `rotate(${(clock * 0.09) % 360} 720 200)`);
          clockH.setAttribute('transform', `rotate(${(clock * 0.0075) % 360} 720 200)`);
        }
      }

      let running = false, last = 0;
      const frame = (now: number) => {
        if (!running) return;
        tick(Math.min(64, now - last), now);
        last = now;
        requestAnimationFrame(frame);
      };
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !running) { running = true; last = performance.now(); requestAnimationFrame(frame); }
        else if (!e.isIntersecting) running = false;
      }).observe(svg);
    }

    // "Draw yours" rows pre-select the blueprint builder above.
    root.querySelectorAll<HTMLAnchorElement>('[data-preset]').forEach((a) => a.addEventListener('click', () => {
      const w = window as unknown as { gkBlueprintPreset?: (p: { leak: string; biz?: string }) => void };
      w.gkBlueprintPreset?.({ leak: a.dataset.preset!, biz: a.dataset.biz || undefined });
    }));
  }
</script>

<style>
  .bpx { max-width: 80rem; margin: 0 auto; padding: 6rem 1.5rem 5rem; scroll-margin-top: 40px; }
  .bpx-eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-accent); }
  .bpx-head h2 { font-family: var(--font-body); font-weight: 800; font-size: clamp(38px, 6vw, 80px); line-height: .98; letter-spacing: -.035em; margin: 14px 0 16px; text-wrap: balance; }
  .bpx-head h2 em { font-style: normal; color: var(--color-accent); }
  .bpx-head p { color: #c4ccd4; font-size: 18px; margin: 0; }

  .bpx-grid { display: grid; grid-template-columns: minmax(0, 400px) minmax(0, 1fr); gap: 48px; margin-top: 40px; align-items: start; }

  .bpx-steps { list-style: none; margin: 0; padding: 0 0 0 0; position: relative; }
  .bpx-rail { position: absolute; left: 21px; top: 30vh; bottom: 30vh; width: 1px; background: var(--color-border); }
  .bpx-rail i { position: absolute; left: -.5px; top: 0; width: 2px; height: 0; background: var(--color-accent); transition: height .6s cubic-bezier(.4,0,.2,1); }
  .bpx-step { min-height: 78vh; display: flex; gap: 22px; align-items: center; position: relative; opacity: .38; transition: opacity .4s; }
  .bpx-step.on { opacity: 1; }
