---
/**
 * FAQ.astro — "Common Questions" accordion section
 * Single-open accordion behavior, smooth open/close via max-height transitions.
 * Uses global utility classes: gradient-text, comment-prefix.
 *
 * Copy lives in src/data/faqs.ts so the visible accordion and the FAQPage
 * JSON-LD in Layout.astro can never drift apart.
 */

import { faqs } from '../data/faqs';
---

<section id="faq" class="pt-24 pb-12 md:pt-32 md:pb-16">
  <div class="mx-auto max-w-3xl px-6">
    <!-- Section Heading -->
    <h2
      class="mb-16 text-center text-3xl font-bold md:text-4xl"
      style="font-family: 'Outfit', sans-serif; letter-spacing: -0.025em;"
    >
      <span class="comment-prefix">// </span><span class="gradient-text">Common Questions</span>
    </h2>

    <!-- Accordion -->
    <div class="faq-accordion">
      {faqs.map((faq) => (
        <div class="faq-item" style="border-bottom: 1px solid rgba(255,255,255,0.06);">
          {/* Question Button */}
          <button
            class="faq-trigger flex w-full items-center justify-between py-5 text-left"
            type="button"
            aria-expanded="false"
            style="font-family: 'Outfit', sans-serif; transition: color 200ms ease;"
          >
            <span class="faq-question pr-4 text-lg text-[#fafaf9]">
              {faq.question}
            </span>
            <span
              class="faq-icon flex-shrink-0 text-[#8b8b8a]"
              aria-hidden="true"
              style="transition: transform 300ms ease;"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="10" y1="4" x2="10" y2="16" class="faq-icon-vertical" />
                <line x1="4" y1="10" x2="16" y2="10" />
              </svg>
            </span>
          </button>

          {/* Answer Panel */}
          <div
            class="faq-panel"
            style="max-height: 0; overflow: hidden; transition: max-height 300ms ease;"
          >
            <p
              class="pb-5 leading-relaxed text-[#8b8b8a]"
              style="font-family: 'Outfit', sans-serif;"
            >
              {faq.answer}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-trigger:hover .faq-question {
    color: #ffffff;
  }

  .faq-item.active .faq-icon {
    transform: rotate(45deg);
  }

  .faq-item.active .faq-icon-vertical {
    opacity: 1;
  }
</style>

<script>
  function initFAQ() {
    const accordion = document.querySelector(".faq-accordion");
    if (!accordion) return;

    const items = accordion.querySelectorAll(".faq-item");

    items.forEach((item) => {
      const trigger = item.querySelector(".faq-trigger");
      const panel = item.querySelector(".faq-panel") as HTMLElement | null;

      if (!trigger || !panel) return;

      trigger.addEventListener("click", () => {
        const isOpen = item.classList.contains("active");

        // Close all items first (single-open behavior)
        items.forEach((otherItem) => {
          const otherPanel = otherItem.querySelector(".faq-panel") as HTMLElement | null;
          const otherTrigger = otherItem.querySelector(".faq-trigger");
          if (otherItem !== item && otherItem.classList.contains("active")) {
            otherItem.classList.remove("active");
            if (otherPanel) otherPanel.style.maxHeight = "0";
            if (otherTrigger) otherTrigger.setAttribute("aria-expanded", "false");
          }
        });

        // Toggle the clicked item
        if (isOpen) {
          item.classList.remove("active");
          panel.style.maxHeight = "0";
          trigger.setAttribute("aria-expanded", "false");
        } else {
          item.classList.add("active");
          panel.style.maxHeight = panel.scrollHeight + "px";
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFAQ);
  } else {
    initFAQ();
  }
</script>
