---
// Act 1 of the homepage story: real products (src/data/proof.ts) that develop from a
// blueprint into the real screen as you scroll. All copy is rendered here as
// real HTML (it is what search engines read); the WebGL stage in
// src/scripts/proof-scene.js is only the picture, and loads lazily.
// mode="auto" (homepage): a normal-height stage that plays itself — never
// holds the page's scroll. mode="scroll" (/projects/): the full pinned,
// scroll-driven version for people who came to look at the work.
import { PROOF_PROJECTS } from '../data/proof';
interface Props { mode?: 'auto' | 'scroll'; finalHref?: string; finalLabel?: string }
const { mode = 'scroll', finalHref = '#blueprint', finalLabel = 'Draw your blueprint ↓' } = Astro.props;
const auto = mode === 'auto';
const N = PROOF_PROJECTS.length;
const WORDS = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const nWord = WORDS[N] ?? String(N);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="pow-intro" aria-labelledby="pow-heading">
  <div class="pow-eyebrow">Proof of work</div>
  <h2 id="pow-heading">Drawn. <span>Built.</span> <em>Shipped.</em></h2>
  {auto
    ? <p>{nWord} products I designed, built and run. Each one started as a constraint somebody lived with every day. Watch each blueprint build itself into the real thing.</p>
    : <p>{nWord} products I designed, built and run. Each one started as a constraint somebody lived with every day. Scroll to watch each blueprint become the real thing.</p>}
  {!auto && <div class="pow-intro-cue"><span class="pow-mouse"><i></i></span>Scroll down. Each blueprint builds itself.</div>}
</section>

<section class={`pow${auto ? ' pow-auto' : ''}`} id="proof-of-work" data-proof data-mode={mode} aria-label={`${N} products Greg Kowalczyk has built`}>
  <div class="pow-stage" data-stage>
    <canvas aria-hidden="true"></canvas>
    <div class="pow-hud">Proof of work<br /><b data-count>01 / {pad(N)}</b></div>
    <ol class="pow-index">
      {PROOF_PROJECTS.map((p, k) => (
        <li><button type="button" data-go={k} aria-current={k === 0 ? 'step' : undefined}><span>{p.name}</span></button></li>
      ))}
      {!auto && <li><button type="button" data-go={N}><span>Your project</span></button></li>}
    </ol>

    <div class="pow-copy">
      {PROOF_PROJECTS.map((p, k) => (
        <article data-article class={k === 0 ? 'on' : undefined}>
          <div class="pow-tag">{pad(k + 1)} · {p.tag}</div>
          <h3>{p.name}</h3>
          <div class="pow-label">The constraint</div>
          <p class="pow-q">{p.constraint}</p>
          <div class="pow-built"><div class="pow-label pow-label-built">What I built</div><p>{p.built}</p></div>
          <div class="pow-stats">
            {p.stats.map(([b, s]) => <div><b>{b}</b><span>{s}</span></div>)}
          </div>
          <div class="pow-row">
            {p.external
              ? <a class="pow-go" data-open href={p.link} target="_blank" rel="noopener noreferrer">{p.linkLabel} ↗</a>
              : <a class="pow-go" data-open href={p.link}>{p.linkLabel} →</a>}
            <span class="pow-stamp" data-stamp>{p.status}</span>
          </div>
        </article>
      ))}
      {!auto && <article data-article class="pow-final">
        <div class="pow-tag">{pad(N)} products · 1 method</div>
        <h3>What's your constraint?</h3>
        <p class="pow-q">Every one of these started with one question. Answer three for your business and I will sketch the system I would build for you.</p>
        <div class="pow-row">
          <a class="pow-cta" href={finalHref}>{finalLabel}</a>
          <a class="pow-go" href="/contact">Book a call →</a>
        </div>
      </article>}
    </div>

    <div class="pow-hint" data-hint><i></i>Hover the blueprint to x-ray it</div>
    {auto
      ? <div class="pow-cue pow-ctrl" data-cue>
          <button type="button" data-prev aria-label="Previous project">←</button>
          <span data-cue-text aria-live="polite">Project 1 of {N}</span><span class="pow-cue-bar"><i data-cue-bar></i></span>
          <button type="button" data-pause aria-label="Pause">❚❚</button>
          <button type="button" data-next aria-label="Next project">→</button>
        </div>
      : <div class="pow-cue" data-cue><span data-cue-text>Scroll to build</span><span class="pow-cue-bar"><i data-cue-bar></i></span><span class="pow-cue-arrow">↓</span></div>}
    <div class="pow-xcur" data-xcur>X-ray</div>
  </div>
</section>
{auto && (
  <div class="pow-after">
    <a href="/projects/">See all {N} with the full scroll story →</a>
    <a href="#blueprint">Draw your own blueprint ↓</a>
  </div>
)}

<script>
  import { PROOF_PROJECTS } from '../data/proof';
  const root = document.querySelector<HTMLElement>('[data-proof]');
  if (root) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        import('../scripts/proof-scene.js').then((m) => m.startProof(root, PROOF_PROJECTS));
      },
      { rootMargin: '800px 0px' }
    );
    io.observe(root);
  }
</script>

<style>
  .pow-intro { max-width: 80rem; margin: 0 auto; padding: 6rem 1.5rem 3rem; }
  .pow-eyebrow, .pow-tag, .pow-label, .pow-hud, .pow-index button, .pow-hint, .pow-cue, .pow-xcur, .pow-go, .pow-stamp, .pow-intro-cue {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }
  .pow-eyebrow { font-size: 12px; letter-spacing: .14em; color: var(--color-accent); }
  .pow-intro h2 { font-family: var(--font-body); font-weight: 800; font-size: clamp(40px, 7vw, 96px); line-height: .95; letter-spacing: -.035em; margin: 16px 0 20px; }
  .pow-intro h2 span { color: var(--color-text-secondary); }
  .pow-intro h2 em { font-style: normal; color: var(--color-accent); }
  .pow-intro p { color: var(--soft); max-width: 58ch; font-size: 18px; }
  .pow-intro-cue { margin-top: 34px; display: flex; align-items: center; gap: 14px; font-size: 11.5px; letter-spacing: .14em; color: var(--soft); }
  .pow-mouse { flex: none; width: 22px; height: 34px; border: 1.5px solid var(--soft); border-radius: 12px; position: relative; }
  .pow-mouse i { position: absolute; left: 50%; top: 6px; width: 3px; height: 7px; margin-left: -1.5px; background: var(--color-accent); border-radius: 2px; animation: pow-wheel 1.6s infinite; }
  @keyframes pow-wheel { 0% { opacity: 0; transform: translateY(-3px); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(10px); } }

  .pow { position: relative; height: 820vh; }
  .pow-auto { height: auto; }
  .pow-auto .pow-stage { position: relative; top: auto; height: min(820px, calc(100svh - 64px)); min-height: 600px; }
  .pow-ctrl { gap: 10px; padding: 6px 8px; }
  .pow-ctrl button { all: unset; cursor: pointer; width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--color-border); font-size: 13px; color: var(--fg); }
  .pow-ctrl button:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .pow-ctrl button:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .pow-ctrl [data-pause] { font-size: 9px; letter-spacing: 1px; }
  .pow-after { max-width: 80rem; margin: 0 auto; padding: 18px 1.5rem 0; display: flex; flex-wrap: wrap; gap: 10px 28px; font-family: var(--font-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; }
  .pow-after a { color: var(--fg); }
  .pow-after a:hover { color: var(--color-accent); }
  .pow-stage { position: sticky; top: 64px; height: calc(100vh - 64px); height: calc(100svh - 64px); overflow: hidden; border-block: 1px solid var(--color-border); }
  .pow-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }
  .pow-stage::before { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, color-mix(in srgb, var(--bg) 94%, transparent) 0, color-mix(in srgb, var(--bg) 78%, transparent) 30%, color-mix(in srgb, var(--bg) 0%, transparent) 48%); }

  .pow-hud { position: absolute; top: 24px; left: clamp(20px, 5vw, 72px); z-index: 3; font-size: 11px; line-height: 1.5; letter-spacing: .14em; color: var(--color-text-secondary); }
  .pow-hud b { color: var(--fg); font-weight: 500; font-variant-numeric: tabular-nums; }

  .pow-index { position: absolute; right: 22px; top: 50%; transform: translateY(-50%); z-index: 3; list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .pow-index:hover { background: linear-gradient(270deg, color-mix(in srgb, var(--bg) 85%, transparent), color-mix(in srgb, var(--bg) 0%, transparent)); padding-left: 40px; }
  .pow-index button { all: unset; cursor: pointer; display: flex; align-items: center; justify-content: flex-end; gap: 10px; font-family: var(--font-mono); font-size: 10.5px; line-height: 1; letter-spacing: .12em; text-transform: uppercase; color: var(--color-text-secondary); padding: 5px 0; }
  .pow-index button::after { content: ""; width: 14px; height: 1px; background: currentColor; transition: width .3s; }
  .pow-index button span { opacity: 0; transform: translateX(6px); transition: opacity .25s, transform .25s; }
  .pow-index:hover button span { opacity: 1; transform: none; }
  .pow-index button[aria-current="step"] { color: var(--color-accent); }
  .pow-index button[aria-current="step"]::after { width: 30px; }
  .pow-index button:focus-visible, .pow-go:focus-visible, .pow-cta:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }

  .pow-copy { position: absolute; z-index: 2; left: clamp(20px, 5vw, 72px); top: 50%; transform: translateY(-46%); width: min(440px, 38vw); display: grid; }
  .pow-copy article { grid-area: 1 / 1; opacity: 0; transform: translateY(16px); transition: opacity .45s ease, transform .55s cubic-bezier(.2,.7,.2,1); pointer-events: none; }
  .pow-copy article.on { opacity: 1; transform: none; pointer-events: auto; }
  .pow-tag { font-size: 11px; line-height: 1.4; letter-spacing: .14em; color: var(--color-text-secondary); }
  .pow-copy h3 { font-family: var(--font-body); font-weight: 800; font-size: clamp(34px, 4vw, 56px); line-height: 1; letter-spacing: -.03em; margin: 10px 0 18px; text-wrap: balance; }
  .pow-label { font-size: 10.5px; line-height: 1; letter-spacing: .16em; color: var(--color-accent); margin-bottom: 6px; }
  .pow-label-built { color: var(--fg); }
  .pow-copy p { margin: 0 0 16px; color: var(--soft); font-size: 15.5px; line-height: 1.6; max-width: 46ch; }
  .pow-copy p.pow-q { color: var(--fg); font-size: 17px; }
  .pow-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; border-top: 1px solid var(--color-border); padding-top: 14px; margin: 4px 0 18px; }
  .pow-stats div { min-width: 0; }
  .pow-stats b { display: block; font-family: var(--font-body); font-weight: 700; font-size: clamp(20px, 2vw, 28px); line-height: 1.05; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .pow-stats span { display: block; font-size: 12px; line-height: 1.35; color: var(--color-text-secondary); margin-top: 4px; }
  .pow-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .pow-go { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; line-height: 1; letter-spacing: .1em; border: 1px solid var(--color-border); padding: 11px 14px; border-radius: 999px; transition: border-color .2s, color .2s; }
  .pow-go:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .pow-stamp { font-weight: 700; font-size: 12px; line-height: 1; letter-spacing: .2em; color: var(--color-accent); border: 2px solid var(--color-accent); padding: 7px 10px; border-radius: 4px; transform: rotate(-7deg) scale(1.6); opacity: 0; transition: transform .35s cubic-bezier(.3,1.6,.5,1), opacity .2s; }
  .pow-stamp.in { opacity: 1; transform: rotate(-7deg) scale(1); }
  .pow-cta { display: inline-flex; align-items: center; gap: 10px; background: var(--color-accent-fill); color: var(--on-accent); font-weight: 700; font-size: 16px; line-height: 1; padding: 16px 26px; border-radius: 999px; }
  .pow-final h3 { font-size: clamp(40px, 5vw, 72px); }

  .pow-hint { position: absolute; z-index: 3; right: clamp(20px, 5vw, 72px); bottom: 26px; font-size: 10.5px; line-height: 1.4; letter-spacing: .14em; color: var(--color-text-secondary); opacity: 0; transition: opacity .3s; }
  .pow-hint i { display: inline-block; width: 8px; height: 8px; border: 1.5px solid var(--color-accent); border-radius: 50%; margin-right: 8px; vertical-align: -1px; }
  .pow-cue { position: absolute; z-index: 3; left: 50%; bottom: 24px; transform: translateX(-50%); display: flex; align-items: center; gap: 12px; padding: 10px 16px; border: 1px solid var(--color-border); border-radius: 999px; background: color-mix(in srgb, var(--bg) 66%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); font-size: 11px; line-height: 1; letter-spacing: .14em; color: var(--fg); white-space: nowrap; transition: opacity .3s; }
  .pow-cue.off { opacity: 0; }
  .pow-cue-bar { width: 72px; height: 2px; background: var(--color-border); position: relative; overflow: hidden; }
  .pow-cue-bar i { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--color-accent); }
  .pow-cue-arrow { color: var(--color-accent); animation: pow-bob 1.4s ease-in-out infinite; }
  @keyframes pow-bob { 50% { transform: translateY(3px); } }
  .pow-xcur { position: absolute; z-index: 4; left: 0; top: 0; pointer-events: none; font-weight: 700; font-size: 10.5px; line-height: 1; letter-spacing: .16em; color: var(--on-accent); background: var(--color-accent); padding: 6px 9px; border-radius: 999px; opacity: 0; transition: opacity .2s; white-space: nowrap; }
  .pow-xcur.on { opacity: 1; }

  /* No WebGL: the copy still steps through on scroll over a plain background. */
  .pow.no-gl canvas { display: none; }

  @media (max-width: 760px) {
    .pow-stage::before { background: linear-gradient(0deg, color-mix(in srgb, var(--bg) 96%, transparent) 0, color-mix(in srgb, var(--bg) 90%, transparent) 48%, color-mix(in srgb, var(--bg) 0%, transparent) 64%); }
    .pow-copy { left: 16px; right: 16px; width: auto; top: auto; bottom: 18px; transform: none; }
    .pow-copy h3 { font-size: 30px; margin: 6px 0 10px; }
    .pow-copy p { font-size: 14px; margin-bottom: 10px; }
    .pow-copy p.pow-q { font-size: 15px; }
    .pow-built { display: none; }
    .pow-stats { margin-bottom: 12px; }
    .pow-stats b { font-size: 19px; }
    .pow-index, .pow-hint { display: none; }
    .pow-hud { top: 16px; left: 16px; }
    .pow-cue { bottom: auto; top: 50px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pow-copy article { transition: opacity .2s linear; transform: none; }
    .pow-stamp { transition: opacity .2s; }
    .pow-mouse i, .pow-cue-arrow { animation: none; }
  }
</style>
