---
/**
 * AsHeardOn.astro — Third-party proof strip.
 *
 * Sits where three fabricated testimonials used to be. Unlike those, every item
 * here is verifiable and needs nobody's permission, and it does double duty:
 * social proof for the reader, and internal links to /media/ where the
 * PodcastEpisode schema consolidating the "Greg Kowalczyk" entity lives.
 *
 * Real client quotes go in <Testimonials /> above this when they arrive.
 */
import { featuredMedia } from '../data/media';

const fmt = (iso?: string) =>
  iso
    ? new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-CA', {
        year: 'numeric',
        month: 'short',
        timeZone: 'UTC',
      })
    : '';
---

<section class="py-16 md:py-20">
  <div class="mx-auto max-w-5xl px-6">
    <p
      class="mb-8 text-center text-sm uppercase tracking-[0.2em]"
      style="font-family: 'JetBrains Mono', monospace; color: #798897;"
    >
      As heard on
    </p>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {featuredMedia.map((item) => (
        <a
          href={`/media/#${item.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`}
          class="glass-card group flex flex-col p-6 transition-all duration-200 hover:scale-[1.02]"
        >
          <p
            class="mb-2 text-sm"
            style="font-family: 'JetBrains Mono', monospace; color: #f06000;"
          >
            {item.show}
          </p>
          <p
            class="mb-3 flex-1 text-lg font-semibold"
            style="font-family: 'Outfit', sans-serif; color: #ffffff;"
          >
            “{item.title}”
          </p>
          <p class="text-sm" style="font-family: 'Outfit', sans-serif; color: #798897;">
            {fmt(item.date)}{item.durationLabel ? ` · ${item.durationLabel}` : ''}
            {item.hosts ? ` · ${item.hosts}` : ''}
          </p>
        </a>
      ))}
    </div>

    <p class="mt-8 text-center">
      <a
        href="/media"
        class="text-sm transition-colors duration-200 hover:text-[#ffffff]"
        style="font-family: 'Outfit', sans-serif; color: #798897;"
      >
        All podcasts, talks &amp; teaching →
      </a>
    </p>
  </div>
</section>
