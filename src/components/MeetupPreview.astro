---
/**
 * MeetupPreview.astro — Homepage banner for the open AI for Business meetups:
 * the next event in each city with registration live (featuredMeetups), side
 * by side with their flyers.
 *
 * Renders nothing when no event has a confirmed date, so the homepage never
 * advertises a meetup that isn't scheduled. Data comes from
 * src/data/meetups.ts; the Event schema lives on /meetups/, not here.
 */
import {
  SERIES_NAME,
  featuredMeetups,
  formatMeetupDate,
  formatLabel,
} from '../data/meetups';

const open = featuredMeetups();
---

{open.length > 0 && (
  <section class="py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <span
            class="mb-3 inline-block rounded-full px-3 py-1 text-xs font-semibold"
            style="font-family: 'JetBrains Mono', monospace; background: rgba(240, 96, 0, 0.14); color: var(--accent-text);"
          >
            FREE MEETUPS
          </span>
          <h2
            class="text-2xl font-bold md:text-3xl"
            style="font-family: 'Outfit', sans-serif; color: var(--fg); letter-spacing: -0.02em;"
          >
            {SERIES_NAME}: practical AI for local business owners
          </h2>
        </div>
        <a
          href="/meetups"
          class="inline-block rounded-full px-5 py-2.5 text-sm font-semibold transition-all duration-200 hover:scale-105"
          style="background: color-mix(in srgb, var(--fg) 6%, transparent); color: var(--fg); border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); font-family: 'Outfit', sans-serif;"
        >How the meetups work →</a>
      </div>

      <div class={`grid gap-6 ${open.length > 1 ? 'md:grid-cols-2' : ''}`}>
        {open.map((m) => (
          <div class="fade-in-up glass-card flex flex-col overflow-hidden p-0 sm:flex-row">
            {m.flyer && (
              <a
                href="/meetups#next-meetup"
                class="flex items-center sm:w-2/5 sm:flex-shrink-0"
                style="background: #000;"
                aria-label={`${SERIES_NAME} ${m.city} meetup details`}
              >
                <img
                  src={m.flyer}
                  alt={m.flyerAlt}
                  width="1200"
                  height="1200"
                  loading="lazy"
                  class="aspect-square w-full object-contain"
                />
              </a>
            )}
            <div class="flex flex-1 flex-col p-6">
              <h3
                class="mb-1 text-xl font-bold"
                style="font-family: 'Outfit', sans-serif; color: var(--fg); letter-spacing: -0.01em;"
              >
                {m.city} · {formatLabel(m.format).toLowerCase()}
              </h3>
              <p class="mb-3 text-sm" style="font-family: 'JetBrains Mono', monospace; color: var(--accent-text);">
                <time datetime={m.start}>{formatMeetupDate(m.date!)}</time>
                {m.timeLabel && <span class="whitespace-nowrap"> · {m.timeLabel}</span>}
              </p>
              {m.topic && (
                <p class="mb-3 text-sm leading-snug" style="font-family: 'Outfit', sans-serif; color: var(--fg); opacity: 0.85;">
                  {m.topic}
                </p>
              )}
              <p class="mb-5 text-sm" style="font-family: 'Outfit', sans-serif; color: var(--muted);">
                {m.venue.name}, {m.venue.locality}. Free to attend.
              </p>
              <a
                href={m.registerUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-auto inline-block self-start rounded-full px-5 py-2.5 text-sm font-semibold transition-all duration-200 hover:scale-105"
                style="background: #f06000; color: var(--on-accent); font-family: 'Outfit', sans-serif;"
              >Save your seat →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
