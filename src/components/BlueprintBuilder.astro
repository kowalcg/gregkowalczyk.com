---
// Act 2 of the homepage story: the visitor answers three questions and gets a
// drawn blueprint of the system I would build, linked to the project where I
// already built one like it. "Book a call" carries the blueprint into the
// contact form (sessionStorage + ?topic=blueprint, read in Contact.astro).
import { BLUEPRINT_BUSINESSES, BLUEPRINT_LEAKS, BLUEPRINT_TOOLS, BLUEPRINT_DEFAULT } from '../data/proof';
const idOf = (name: string, v: string) => `${name}-${v.replace(/\W+/g, '-').toLowerCase()}`;
---

<section class="bp" id="blueprint" aria-labelledby="bp-heading">
  <div class="bp-head">
    <div class="bp-eyebrow">Your turn</div>
    <h2 id="bp-heading">Draw <em>your</em> blueprint.</h2>
    <p>Three taps. I will sketch the system I would build for your business, and show you where I have already built one like it.</p>
  </div>
  <div class="bp-grid">
    <form class="bp-form" id="bp-form">
      <fieldset>
        <legend><b>1</b>Your business</legend>
        <div class="bp-chips">
          {BLUEPRINT_BUSINESSES.map((b) => (
            <label class="bp-chip"><input type="radio" name="biz" id={idOf('biz', b.id)} value={b.id} checked={b.id === BLUEPRINT_DEFAULT.biz} /><span>{b.label}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend><b>2</b>Where you lose the most time</legend>
        <div class="bp-chips">
          {BLUEPRINT_LEAKS.map((l) => (
            <label class="bp-chip"><input type="radio" name="leak" id={idOf('leak', l.id)} value={l.id} checked={l.id === BLUEPRINT_DEFAULT.leak} /><span>{l.label}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend><b>3</b>Tools you already use <small>· pick any</small></legend>
        <div class="bp-chips">
          {BLUEPRINT_TOOLS.map((t) => (
            <label class="bp-chip"><input type="checkbox" name="tools" id={idOf('tools', t)} value={t} checked={BLUEPRINT_DEFAULT.tools.includes(t)} /><span>{t}</span></label>
          ))}
        </div>
      </fieldset>
    </form>
    <figure class="bp-sheet">
      <svg id="bp-svg" viewBox="0 0 900 560" role="img" aria-labelledby="bp-svg-title"><title id="bp-svg-title">Your system blueprint</title></svg>
      <figcaption class="bp-out">
        <p id="bp-summary">For your studio: a decision dashboard with an AI analyst that works with the tools you already use.</p>
        <div class="bp-row">
          <a class="bp-cta" id="bp-book" href="/contact?topic=blueprint">Book a free 15-minute call →</a>
          <button type="button" class="bp-copy" id="bp-copy">Copy my blueprint</button>
        </div>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { BLUEPRINT_BUSINESSES, BLUEPRINT_LEAKS, BLUEPRINT_DEFAULT, PROOF_PROJECTS } from '../data/proof';

  const form = document.getElementById('bp-form') as HTMLFormElement | null;
  const svg = document.getElementById('bp-svg');
  const summary = document.getElementById('bp-summary');
  const copyBtn = document.getElementById('bp-copy') as HTMLButtonElement | null;
  const book = document.getElementById('bp-book');
  const state = { ...BLUEPRINT_DEFAULT, tools: [...BLUEPRINT_DEFAULT.tools] };
  let touched = false;

  const esc = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const wrap = (text: string, max: number) => {
    const lines: string[] = []; let line = '';
    text.split(' ').forEach((w) => { if ((line + ' ' + w).trim().length > max) { lines.push(line.trim()); line = w; } else line += ' ' + w; });
    if (line.trim()) lines.push(line.trim());
    return lines;
  };
  const tspans = (lines: string[], x: number, y: number, lh: number) => lines.map((l, i) => `<tspan x="${x}" y="${y + i * lh}">${esc(l)}</tspan>`).join('');
  const joinList = (a: string[]) => (a.length < 2 ? a.join('') : a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1]);

  // Every label must stay inside its box, whatever the visitor picks: measure
  // each [data-fit] text and scale its font down if it is wider than its budget.
  function fitText() {
    if (!svg) return;
    svg.querySelectorAll<SVGTextElement>('[data-fit]').forEach((t) => {
      const max = Number(t.dataset.fit);
      if (!t.dataset.fs) t.dataset.fs = t.getAttribute('font-size') || getComputedStyle(t).fontSize;
      t.setAttribute('font-size', t.dataset.fs);
      const w = t.getBBox().width;
      if (w > max) t.setAttribute('font-size', (parseFloat(t.dataset.fs) * (max / w) * 0.98).toFixed(2));
    });
  }
  document.fonts?.ready.then(fitText);

  function render() {
    if (!svg || !summary) return;
    const b = BLUEPRINT_BUSINESSES.find((x) => x.id === state.biz)!;
    const L = BLUEPRINT_LEAKS.find((x) => x.id === state.leak)!;
    const noun = b.noun;
    const tools = state.tools; // every tool they picked gets a box (was capped at 5)
    const toolText = tools.length ? joinList(tools) : 'the tools you already use';
    const short = tools.length ? tools.slice(0, 2).join(' + ') + (tools.length > 2 ? ' +' + (tools.length - 2) : '') : 'your tools';
    const fill = (s: string) => s.replace('TOOLS', short).replace(/NOUN/g, noun);
    const today = new Date().toLocaleDateString('en-CA');
    let d = 0; const stepLen = state.tools.length > 5 ? 0.045 : 0.08; // many inputs: draw faster, same total time
    const step = () => (d += stepLen).toFixed(2) + 's';
    const mono = 'font-family="JetBrains Mono, monospace"';
    const sans = 'font-family="Outfit, sans-serif"';

    let o = `<defs>
      <pattern id="bp-g1" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="var(--grid)" stroke-width="1"/></pattern>
      <pattern id="bp-g2" width="100" height="100" patternUnits="userSpaceOnUse"><rect width="100" height="100" fill="url(#bp-g1)"/><path d="M100 0H0V100" fill="none" stroke="var(--grid-major)" stroke-width="1"/></pattern>
    </defs>
    <rect width="900" height="560" fill="var(--panel)"/><rect width="900" height="560" fill="url(#bp-g2)"/>
    <rect x="12" y="12" width="876" height="536" fill="none" stroke="var(--line)"/>
    <path d="M12 30V12H30M870 548H888V530" fill="none" stroke="#f06000" stroke-width="2"/>
    <text data-fit="830" x="32" y="44" fill="var(--muted)" ${mono} font-size="11" letter-spacing="2">SYSTEM BLUEPRINT · ${esc(b.label.toUpperCase())}</text>`;

    const nodes = tools.length ? tools : ['Your current tools'];
    // up to 5 boxes at full size; more than that get compact so all 10 fit the sheet
    const n = nodes.length, compact = n > 5, boxH = compact ? 28 : 40, gap = compact ? Math.min(34, 330 / n) : Math.min(64, 300 / n), top = 262 - ((n - 1) * gap) / 2;
    o += `<text class="bp-fade" style="--d:.1s" x="40" y="${top - 38}" fill="var(--muted)" ${mono} font-size="11" letter-spacing="2">INPUTS</text>`;
    nodes.forEach((t, i) => {
      const y = top + i * gap, ty = 262 + (i - (n - 1) / 2) * 18;
      o += `<rect class="bp-draw" style="--d:${step()}" pathLength="1" x="40" y="${y - boxH / 2}" width="190" height="${boxH}" rx="6" fill="var(--panel-2)" stroke="${tools.length ? 'var(--soft)' : 'var(--muted)'}" stroke-width="1.2"/>`;
      o += `<text data-fit="164" class="bp-fade" style="--d:${step()}" x="56" y="${y + (compact ? 4.5 : 5)}" fill="var(--fg)" ${sans} font-size="${compact ? 13.5 : 15}">${esc(t)}</text>`;
      o += `<path id="bp-lk${i}" class="bp-draw" style="--d:${step()}" pathLength="1" d="M230 ${y} C 280 ${y}, 280 ${ty}, 330 ${ty}" fill="none" stroke="#f06000" stroke-width="1.6"/>`;
      o += `<circle class="bp-dot" r="3.5" fill="#f06000" opacity="0"><set attributeName="opacity" to="1" begin="${1.2 + i * 0.3}s"/><animateMotion dur="2.2s" begin="${1.2 + i * 0.3}s" repeatCount="indefinite"><mpath href="#bp-lk${i}"/></animateMotion></circle>`;
    });

    const sys = wrap(L.system, 22);
    o += `<rect class="bp-draw" style="--d:${step()}" pathLength="1" x="330" y="112" width="290" height="300" rx="10" fill="var(--panel-accent)" stroke="#f06000" stroke-width="2"/>`;
    o += `<text class="bp-fade" style="--d:${step()}" x="352" y="142" fill="#f06000" ${mono} font-size="11" letter-spacing="2">THE SYSTEM I WOULD BUILD</text>`;
    o += `<text data-fit="248" class="bp-fade" style="--d:${step()}" fill="var(--fg)" ${sans} font-weight="700" font-size="26">${tspans(sys, 352, 180, 30)}</text>`;
    const py0 = 180 + sys.length * 30 + 18;
    L.parts.forEach((pt, i) => {
      const y = py0 + i * 58;
      o += `<rect class="bp-draw" style="--d:${step()}" pathLength="1" x="352" y="${y - 12}" width="12" height="12" fill="none" stroke="#f06000" stroke-width="1.5"/>`;
      o += `<text data-fit="226" class="bp-fade" style="--d:${step()}" fill="var(--soft)" ${sans} font-size="15">${tspans(wrap(fill(pt), 30), 376, y, 19)}</text>`;
    });

    o += `<path id="bp-out" class="bp-draw" style="--d:${step()}" pathLength="1" d="M620 262 H 690" fill="none" stroke="#f06000" stroke-width="1.6"/>`;
    o += `<path class="bp-draw" style="--d:${step()}" pathLength="1" d="M682 256 L690 262 L682 268" fill="none" stroke="#f06000" stroke-width="1.6"/>`;
    o += `<circle class="bp-dot" r="3.5" fill="var(--fg)" opacity="0"><set attributeName="opacity" to="1" begin="2s"/><animateMotion dur="1.4s" begin="2s" repeatCount="indefinite"><mpath href="#bp-out"/></animateMotion></circle>`;
    const out = wrap(fill(L.outcome), 17);
    o += `<rect class="bp-draw" style="--d:${step()}" pathLength="1" x="690" y="${262 - 30 - out.length * 12}" width="176" height="${60 + out.length * 24}" rx="8" fill="var(--panel-2)" stroke="var(--fg)" stroke-width="1.4"/>`;
    o += `<text class="bp-fade" style="--d:${step()}" x="706" y="${262 - 8 - out.length * 12}" fill="var(--muted)" ${mono} font-size="10.5" letter-spacing="2">THE GOAL</text>`;
    o += `<text data-fit="146" class="bp-fade" style="--d:${step()}" fill="var(--fg)" ${sans} font-weight="600" font-size="17">${tspans(out, 706, 262 + 18 - out.length * 12, 22)}</text>`;

    o += `<a href="#proof-of-work" class="bp-proof" data-k="${PROOF_PROJECTS.findIndex((p) => p.slug === L.proof)}"><rect class="bp-draw" style="--d:${step()}" pathLength="1" x="330" y="440" width="536" height="72" rx="8" fill="var(--panel-2)" stroke="var(--line)" stroke-width="1.2"/>
      <text class="bp-fade" style="--d:${step()}" x="350" y="466" fill="#f06000" ${mono} font-size="10.5" letter-spacing="2">BUILT BEFORE · SEE IT ABOVE ↑</text>
      <text data-fit="496" class="bp-fade" style="--d:${step()}" x="350" y="494" fill="var(--fg)" ${sans} font-size="17">${esc(L.proofText)}</text></a>`;
    o += `<g class="bp-fade" style="--d:${step()}" ${mono} font-size="10" letter-spacing="1.5" fill="var(--muted)">
      <rect x="40" y="440" width="250" height="72" fill="none" stroke="var(--line)"/><path d="M40 464H290M40 488H290M150 440V512" stroke="var(--line)"/>
      <text x="50" y="456">DWG</text><text data-fit="122" x="160" y="456" fill="var(--fg)">${esc(state.biz.toUpperCase())}-${esc(state.leak.toUpperCase())}-01</text>
      <text x="50" y="480">DRAWN BY</text><text x="160" y="480" fill="var(--fg)">G. KOWALCZYK</text>
      <text x="50" y="504">DATE</text><text data-fit="122" x="160" y="504" fill="var(--fg)">${today}</text></g>`;
    svg.innerHTML = '<title id="bp-svg-title">Your system blueprint</title>' + o;
    fitText();

    const sysName = L.system.charAt(0).toLowerCase() + L.system.slice(1); // keeps "AI" as AI
    const article = /^your /.test(sysName) ? '' : /^[aeiou]/.test(sysName) ? 'an ' : 'a ';
    summary.innerHTML = `For ${esc(noun)}: ${article}<b>${esc(sysName)}</b> that works with ${esc(toolText)}. The goal: ${esc(fill(L.outcome).toLowerCase())}. I have built this kind of thing before: ${esc(L.proofText)}.`;
    summary.dataset.text = [
      'My blueprint from gregkowalczyk.com',
      `Business: ${b.label}`,
      `Biggest time sink: ${L.label}`,
      `Tools: ${toolText}`,
      `System: ${L.system}`,
      ...L.parts.map((pt) => `- ${fill(pt)}`),
      `Goal: ${fill(L.outcome)}`,
    ].join('\n');
    // BuildProcess.astro listens and redraws its schematic with these answers.
    window.dispatchEvent(new CustomEvent('gk-blueprint', { detail: { touched, tools: state.tools, system: L.system, noun } }));
  }

  form?.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    touched = true;
    if (t.name === 'biz') state.biz = t.value;
    if (t.name === 'leak') state.leak = t.value;
    if (t.name === 'tools') state.tools = [...form.querySelectorAll<HTMLInputElement>('input[name="tools"]:checked')].map((i) => i.value);
    render();
  });
  form?.addEventListener('submit', (e) => e.preventDefault());

  // "What I build" rows in BuildProcess.astro pre-select an answer here.
  (window as unknown as { gkBlueprintPreset?: (p: { leak: string; biz?: string }) => void }).gkBlueprintPreset = ({ leak, biz }) => {
    const pick = (name: string, v?: string) => {
      const el = v ? form?.querySelector<HTMLInputElement>(`input[name="${name}"][value="${v}"]`) : null;
      if (el) el.checked = true;
    };
    pick('leak', leak); pick('biz', biz);
    state.leak = leak; if (biz) state.biz = biz;
    touched = true;
    render();
  };

  svg?.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a.bp-proof') as SVGAElement | null;
    if (!a) return;
    const k = Number(a.dataset.k);
    const go = (window as unknown as { goProject?: (k: number) => void }).goProject;
    if (go) { e.preventDefault(); go(k); }
  });

  // The contact form reads this and pre-fills the message (Contact.astro).
  book?.addEventListener('click', () => {
    try { sessionStorage.setItem('gk-blueprint', summary?.dataset.text || ''); } catch { /* storage blocked: the form still opens */ }
  });

  copyBtn?.addEventListener('click', () => {
    const text = summary?.dataset.text || '';
    const done = () => { copyBtn.textContent = 'Copied'; setTimeout(() => { copyBtn.textContent = 'Copy my blueprint'; }, 1800); };
    (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject()).then(done).catch(() => {
      if (!summary) return;
      const r = document.createRange(); r.selectNodeContents(summary);
      const sel = getSelection(); sel?.removeAllRanges(); sel?.addRange(r);
      copyBtn.textContent = 'Selected — press Copy';
    });
  });

  render();
</script>

<style>
  .bp { max-width: 80rem; margin: 0 auto; padding: 6.5rem 1.5rem 4.5rem; scroll-margin-top: 64px; }
  .bp-eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--color-accent); }
  .bp-head h2 { font-family: var(--font-body); font-weight: 800; font-size: clamp(40px, 6.4vw, 88px); line-height: .95; letter-spacing: -.035em; margin: 14px 0 18px; }
  .bp-head h2 em { font-style: normal; color: var(--color-accent); }
  .bp-head p { color: var(--soft); max-width: 60ch; font-size: 18px; }
  .bp-grid { display: grid; grid-template-columns: minmax(0, 380px) minmax(0, 1fr); gap: 44px; margin-top: 44px; align-items: start; }
  .bp-form fieldset { border: 0; margin: 0 0 28px; padding: 0; min-width: 0; }
  .bp-form legend { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 12px; line-height: 1.4; letter-spacing: .12em; text-transform: uppercase; color: var(--fg); margin-bottom: 12px; padding: 0; }
  .bp-form legend b { flex: none; width: 22px; height: 22px; border-radius: 50%; background: var(--color-accent-fill); color: var(--on-accent); display: grid; place-items: center; font-size: 11px; }
  .bp-form legend small { color: var(--color-text-secondary); font-size: 11px; }
  .bp-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .bp-chip { position: relative; }
  .bp-chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .bp-chip span { display: inline-block; padding: 9px 14px; border: 1px solid var(--color-border); border-radius: 999px; font-size: 14.5px; line-height: 1.2; color: var(--soft); cursor: pointer; transition: border-color .15s, background .15s, color .15s; }
  .bp-chip span:hover { border-color: var(--color-text-secondary); color: var(--fg); }
  .bp-chip input:checked + span { border-color: var(--color-accent); background: var(--color-accent-fill); color: var(--on-accent); font-weight: 600; }
  .bp-chip input:focus-visible + span { outline: 2px solid var(--fg); outline-offset: 2px; }
  .bp-sheet { margin: 0; border: 1px solid var(--color-border); border-radius: 12px; background: var(--panel); padding: 10px; min-width: 0; position: sticky; top: 84px; }
  #bp-svg { width: 100%; height: auto; display: block; }
  .bp-out { padding: 16px 8px 6px; display: grid; gap: 16px; }
  #bp-summary { color: var(--soft); font-size: 16.5px; margin: 0; }
  #bp-summary :global(b) { color: var(--fg); font-weight: 600; }
  .bp-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .bp-cta { display: inline-flex; align-items: center; gap: 10px; background: var(--color-accent-fill); color: var(--on-accent); font-weight: 700; font-size: 16px; line-height: 1; padding: 16px 26px; border-radius: 999px; }
  .bp-copy { font-family: var(--font-mono); font-size: 12px; line-height: 1; letter-spacing: .1em; text-transform: uppercase; color: var(--fg); background: none; border: 1px solid var(--color-border); padding: 12px 14px; border-radius: 999px; cursor: pointer; }
  .bp-copy:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .bp-cta:focus-visible, .bp-copy:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  #bp-svg :global(.bp-draw) { stroke-dasharray: 1; stroke-dashoffset: 1; animation: bp-draw .9s cubic-bezier(.4,0,.2,1) forwards; animation-delay: var(--d, 0s); }
  #bp-svg :global(.bp-fade) { opacity: 0; animation: bp-fade .5s ease forwards; animation-delay: var(--d, 0s); }
  #bp-svg :global(.bp-proof) { cursor: pointer; }
  @keyframes bp-draw { to { stroke-dashoffset: 0; } }
  @keyframes bp-fade { to { opacity: 1; } }
  @media (max-width: 900px) { .bp-grid { grid-template-columns: 1fr; } .bp-sheet { position: static; } }
  @media (prefers-reduced-motion: reduce) {
    #bp-svg :global(.bp-draw) { animation: none; stroke-dashoffset: 0; }
    #bp-svg :global(.bp-fade) { animation: none; opacity: 1; }
    #bp-svg :global(.bp-dot) { display: none; }
  }
</style>
