---
/**
 * Hero.astro — Full-viewport hero section
 * Typing effect, gradient headline, headshot, dot grid background.
 */

import { yearsInEngineering } from '../data/site';
---

<section
  id="hero"
  class="dot-grid relative flex min-h-[88vh] items-center overflow-hidden"
>
  <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-center lg:gap-16">
      <!-- Text Content (left on desktop, top on mobile) -->
      <div class="w-full text-center lg:w-[60%] lg:text-left">
        <!-- Eyebrow — the one place the accent appears above the fold -->
        <p
          class="mb-5 text-sm sm:text-base"
          style="font-family: 'JetBrains Mono', 'Fira Code', monospace; color: #f06000; letter-spacing: 0.08em;"
        >
          business growth &middot; engineered
        </p>

        <!-- H1 Headline -->
        <h1
          class="mb-6 text-4xl font-bold md:text-5xl lg:text-6xl"
          style="font-family: 'Outfit', sans-serif; color: #ffffff; letter-spacing: -0.035em; line-height: 1.04; text-wrap: balance;"
        >
          I grow businesses like an engineer.
        </h1>

        <!-- Sub-headline -->
        <p
          class="mx-auto mb-8 max-w-xl text-base leading-relaxed text-[#798897] sm:text-lg lg:mx-0"
          style="font-family: 'Outfit', sans-serif;"
        >
          Find the constraint. Fix it. Automate it. {yearsInEngineering} years in engineering, from
          draftsman to manager of a 70-person department. Two e-commerce brands built and run since 2014.
          AI is my current best tool — it replaced $75K+ a year of agency work in my own businesses
          before I ever built a system for a client.
        </p>

        <!-- CTA Button -->
        <div class="mb-4">
          <a
            href="/contact"
            class="inline-block rounded-full px-8 py-4 text-base font-semibold  shadow-lg transition-all duration-200 hover:scale-105 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f06000] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1a1a]"
            style="background: #f06000; color: #000000; font-family: 'Outfit', sans-serif;"
          >Book a call</a>
        </div>

        <!-- Location Subtext -->
        <p
          class="text-sm text-[#798897]"
          style="font-family: 'Outfit', sans-serif;"
        >
          Based in Oakville, Ontario — serving the GTA and beyond
        </p>
      </div>

      <!-- Headshot Area (right on desktop, bottom on mobile) -->
      <div class="flex w-full justify-center lg:w-[40%]">
        <div
          class="relative h-[280px] w-[280px] overflow-hidden rounded-2xl sm:h-[320px] sm:w-[320px]"
          style="padding: 1px; background: rgba(255,255,255,0.14);"
        >
          <!-- Inner container with rounded corners -->
          <div class="relative h-full w-full overflow-hidden rounded-2xl" style="background-color: rgba(255, 255, 255, 0.05);">
            <!-- Fallback gradient background -->
            <div
              class="absolute inset-0 flex items-center justify-center"
              style="background: rgba(240, 96, 0, 0.10);"
            >
              <span
                class="text-5xl text-[#798897] opacity-30"
                style="font-family: 'JetBrains Mono', monospace;"
              >
                GK
              </span>
            </div>
            <!-- Actual headshot image -->
            <img
              src="/images/greg-headshot.jpg"
              alt="Greg Kowalczyk - Business Growth Engineer in Oakville, Ontario"
              class="relative z-10 h-full w-full object-cover"
              loading="eager"
              onerror="this.style.display='none';"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

