---
/**
 * ProjectsPreview.astro — homepage teaser for /projects/.
 *
 * Previously hardcoded its own copy of each project's name, tag and description,
 * duplicating the projects page — and the fourth card had drifted outside the
 * flex container, so it rendered outside the grid. It now reads the entries
 * marked `featured: true` in src/content/projects, so the two cannot diverge.
 */
import { getCollection } from 'astro:content';

const featured = (await getCollection('projects', ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

/** Initials for the tile when a project doesn't specify them. */
const initialsFor = (name: string, explicit?: string) =>
  explicit ??
  name
    .replace(/[^a-zA-Z ]/g, '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0].toUpperCase())
    .join('');

const hasDetail = (p: (typeof featured)[number]) => (p.body ?? '').trim().length > 0;
---

<section class="py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      class="mb-4 text-center text-3xl font-bold md:text-4xl"
      style="font-family: 'Outfit', sans-serif; letter-spacing: -0.025em;"
    >
      <span class="comment-prefix">// </span><span class="gradient-text">Things I've Built</span>
    </h2>
    <p class="mb-12 text-center" style="font-family: 'Outfit', sans-serif; color: #8b8b8a;">
      Not demos. Real tools, apps, and systems deployed and running.
    </p>

    <div class="flex flex-col gap-6">
      {featured.map((project) => {
        const href = hasDetail(project) ? `/projects/${project.slug}/` : '/projects';
        const accent =
          project.data.tagColor === 'purple'
            ? { bg: 'rgba(229, 52, 31, 0.1)', fg: '#e5341f' }
            : { bg: 'rgba(229, 52, 31, 0.1)', fg: '#e5341f' };
        return (
          <a
            href={href}
            class="fade-in-up glass-card block p-8 transition-all duration-200 hover:scale-[1.01]"
          >
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:gap-8">
              <div
                class="flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-xl"
                style="background: rgba(229, 52, 31, 0.10); border: 1px solid rgba(255,255,255,0.08);"
              >
                <span style="font-family: 'JetBrains Mono', monospace; color: #fafaf9; opacity: 0.5; font-weight: bold;">
                  {initialsFor(project.data.name, project.data.initials)}
                </span>
              </div>
              <div>
                <div class="mb-2 flex flex-wrap items-center gap-3">
                  <span
                    class="rounded-full px-3 py-1 text-xs"
                    style={`font-family: 'JetBrains Mono', monospace; background: ${accent.bg}; color: ${accent.fg};`}
                  >
                    {project.data.tag}
                  </span>
                </div>
                <h3
                  class="mb-2 text-lg font-bold"
                  style="font-family: 'JetBrains Mono', monospace; color: #fafaf9;"
                >
                  {project.data.name}
                </h3>
                <p class="text-sm leading-relaxed" style="font-family: 'Outfit', sans-serif; color: #8b8b8a;">
                  {project.data.description}
                </p>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/projects"
        class="inline-block rounded-full px-6 py-3 text-sm font-semibold transition-all duration-200 hover:scale-105"
        style="background: rgba(255,255,255,0.06); color: #fafaf9; border: 1px solid rgba(255,255,255,0.12); font-family: 'Outfit', sans-serif;"
      >
        View All Projects →
      </a>
    </div>
  </div>
</section>
