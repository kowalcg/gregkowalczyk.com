---
/**
 * About.astro — About Greg section
 * Bio, headshot with gradient border, and career timeline.
 * Two-column layout on desktop (60/40), stacked on mobile (image first).
 */

const timelineEntries = [
  {
    years: "1997-2011",
    title: "Mechanical Designer to Manager of Engineering",
    subtitle: "(PRO-ECO / SMS-Siemag)",
    dotColor: "#f06000",
  },
  {
    years: "2011-2019",
    title: "Consulting Engineer",
    subtitle: "(independent, multiple companies)",
    dotColor: "#f06000",
  },
  {
    years: "2014-Present",
    title: "E-Commerce Entrepreneur",
    subtitle: "(GearTOP + TapeGeeks)",
    dotColor: "#f06000",
  },
  {
    years: "2019-Present",
    title: "E-Commerce Consulting",
    subtitle: "",
    dotColor: "#f06000",
  },
  {
    years: "2022-Present",
    title: "Building With AI",
    subtitle: "(Jarvis, then Jasper, then ChatGPT and Claude)",
    dotColor: "#f06000",
  },
];
---

<section id="about" class="py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section Heading -->
    <h2
      class="mb-16 text-center text-3xl font-bold md:text-4xl"
      style="font-family: 'Outfit', sans-serif; letter-spacing: -0.025em;"
    >
      <span class="comment-prefix">// </span><span class="gradient-text">My story</span>
    </h2>

    <!-- Bio + Headshot Grid -->
    <div class="fade-in-up grid grid-cols-1 items-start gap-12 lg:grid-cols-[3fr_2fr] lg:gap-16">

      <!-- Image Column (shows first on mobile via order) -->
      <div class="flex flex-col items-center order-first lg:order-last">
        <!-- Headshot with gradient border -->
        <div
          class="relative overflow-hidden rounded-2xl"
          style="width: 300px; padding: 1px; background: color-mix(in srgb, var(--fg) 14%, transparent);"
        >
          <div
            class="relative h-full w-full overflow-hidden rounded-2xl"
            style="background: color-mix(in srgb, var(--fg) 5%, transparent);"
          >
            <!-- Fallback gradient background -->
            <div
              class="absolute inset-0 flex items-center justify-center"
              style="background: rgba(240, 96, 0, 0.10);"
            >
              <span
                class="text-5xl opacity-30"
                style="font-family: 'JetBrains Mono', monospace; color: var(--muted);"
              >
                GK
              </span>
            </div>
            <img
              src="/images/greg-headshot.jpg"
              alt="Greg Kowalczyk"
              class="relative z-10 w-full object-cover"
              style="aspect-ratio: 3 / 4;"
              loading="lazy"
              onerror="this.style.display='none';"
            />
          </div>
        </div>
        <!-- Location -->
        <p
          class="mt-4 text-center text-sm"
          style="font-family: 'Outfit', sans-serif; color: var(--muted);"
        >
          Oakville, Ontario
        </p>
      </div>

      <!-- Text Column -->
      <div class="order-last lg:order-first">
        <div class="space-y-4" style="font-family: 'Outfit', sans-serif;">
          <p class="leading-relaxed" style="color: var(--muted);">
            I'm an engineer who builds things. I graduated in 1997 and started as a mechanical designer, and became Manager of Engineering for a 70-person department at PRO-ECO / SMS-Siemag — fourteen years on global-scale industrial projects.
          </p>
          <p class="leading-relaxed" style="color: var(--muted);">
            In 2011 I left the corporate job and spent the next eight years as a consulting engineer, working across a lot of different companies. In 2014 I started building e-commerce brands with my daughter — two of them, running ever since. I learned SEO, ads, and marketing by doing it rather than reading about it, and spent $2M+ on advertising across Google, Amazon, and Meta. From 2019 the consulting shifted to e-commerce.
          </p>
          <p class="leading-relaxed" style="color: var(--muted);">
            I started using AI in production in 2022 — Jarvis first, then Jasper, well before most people had heard of any of it. When ChatGPT and Claude arrived I went deep. Since then: custom tools that replaced $75K+ in agency costs, two iOS apps shipped without a coding background, and a lot of other businesses helped to do the same.
          </p>
          <p class="leading-relaxed" style="color: var(--fg);">
            Now I build AI systems for businesses that want working solutions, not strategy decks. Everything I recommend, I've tested on my own businesses first. With my own money.
          </p>
        </div>
      </div>

    </div>

    <!-- Timeline -->
    <div class="fade-in-up mt-20">
      <!-- Desktop: Horizontal Timeline -->
      <div class="hidden md:block">
        <div class="relative">
          <!-- Gradient connecting line -->
          <div
            class="absolute top-3 left-0 right-0 h-0.5"
            style="background: linear-gradient(90deg, #f06000, #f06000);"
          ></div>

          <!-- Timeline entries -->
          <div class="grid gap-4" style={`grid-template-columns: repeat(${timelineEntries.length}, minmax(0, 1fr));`}>
            {timelineEntries.map((entry) => (
              <div class="relative pt-8">
                <!-- Dot -->
                <div
                  class="absolute top-0 left-0 h-6 w-6 rounded-full border-4"
                  style={`background-color: ${entry.dotColor}; border-color: var(--surface-2); box-shadow: 0 0 0 2px ${entry.dotColor};`}
                ></div>
                <!-- Year -->
                <p
                  class="mb-1 text-sm"
                  style="font-family: 'JetBrains Mono', 'Fira Code', monospace; color: var(--accent-text);"
                >
                  {entry.years}
                </p>
                <!-- Title -->
                <p
                  class="font-semibold"
                  style="font-family: 'Outfit', sans-serif; color: var(--fg);"
                >
                  {entry.title}
                </p>
                <!-- Subtitle -->
                {entry.subtitle && (
                  <p
                    class="text-sm"
                    style="font-family: 'Outfit', sans-serif; color: var(--muted);"
                  >
                    {entry.subtitle}
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Mobile: Vertical Timeline -->
      <div class="block md:hidden" aria-hidden="true">
        <div class="relative ml-3">
          <!-- Gradient vertical line -->
          <div
            class="absolute top-0 bottom-0 left-0 w-0.5"
            style="background: linear-gradient(180deg, #f06000, #f06000);"
          ></div>

          <!-- Timeline entries -->
          <div class="flex flex-col gap-8">
            {timelineEntries.map((entry) => (
              <div class="relative pl-8">
                <!-- Dot -->
                <div
                  class="absolute top-0.5 -left-[9px] h-5 w-5 rounded-full border-4"
                  style={`background-color: ${entry.dotColor}; border-color: var(--surface-2); box-shadow: 0 0 0 2px ${entry.dotColor};`}
                ></div>
                <!-- Year -->
                <p
                  class="mb-1 text-sm"
                  style="font-family: 'JetBrains Mono', 'Fira Code', monospace; color: var(--accent-text);"
                >
                  {entry.years}
                </p>
                <!-- Title -->
                <p
                  class="font-semibold"
                  style="font-family: 'Outfit', sans-serif; color: var(--fg);"
                >
                  {entry.title}
                </p>
                <!-- Subtitle -->
                {entry.subtitle && (
                  <p
                    class="text-sm"
                    style="font-family: 'Outfit', sans-serif; color: var(--muted);"
                  >
                    {entry.subtitle}
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
