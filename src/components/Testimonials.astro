---
/**
 * Testimonials.astro — Real client quotes only.
 *
 * ⚠️ This component previously shipped three INVENTED quotes attributed to
 * "Client Name / Business Owner / Company Name" under the heading "What Clients
 * Say". They were live in production. Never do that again — an empty section is
 * honest, a fabricated one is not.
 *
 * Rules for adding an entry:
 *   1. The quote must be something the person actually said or wrote.
 *   2. Real name, real title, real company — no placeholders, no composites.
 *   3. You must have their explicit permission to publish it.
 *
 * The section renders nothing while this array is empty, so it is safe to
 * deploy as-is.
 */

interface Testimonial {
  quote: string;
  name: string;
  title: string;
  company: string;
}

const testimonials: Testimonial[] = [
  // Awaiting real, permissioned client quotes. Do not add anything here that
  // the named person has not agreed in writing to have published.
];
---

{testimonials.length > 0 && (
<section class="py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section Heading -->
    <h2
      class="mb-4 text-center text-3xl font-bold md:text-4xl"
      style="font-family: 'Outfit', sans-serif; letter-spacing: -0.025em;"
    >
      <span class="comment-prefix">// </span><span class="gradient-text">What Clients Say</span>
    </h2>
    <p
      class="mx-auto mb-16 max-w-2xl text-center text-[#8b8b8a]"
      style="font-family: 'Outfit', sans-serif;"
    >
      Results from businesses that made the switch from agencies to AI systems.
    </p>

    <!-- Testimonial Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <div class="fade-in-up glass-card flex flex-col p-8">
          <!-- Quote mark -->
          <div
            class="mb-4 text-4xl leading-none"
            style="color: rgba(229, 52, 31, 0.4); font-family: Georgia, serif;"
            aria-hidden="true"
          >
            &ldquo;
          </div>

          <!-- Quote text -->
          <p
            class="mb-6 flex-1 leading-relaxed"
            style="font-family: 'Outfit', sans-serif; color: #8b8b8a;"
          >
            {t.quote}
          </p>

          <!-- Attribution -->
          <div class="flex items-center gap-3">
            <!-- Avatar placeholder -->
            <div
              class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full"
              style="background: rgba(229, 52, 31, 0.10); border: 1px solid rgba(255,255,255,0.1);"
            >
              <span
                class="text-xs font-semibold"
                style="color: #8b8b8a; font-family: 'JetBrains Mono', monospace;"
              >
                {t.name.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
              </span>
            </div>

            <!-- Name and title -->
            <div>
              <p
                class="font-semibold"
                style="font-family: 'Outfit', sans-serif; color: #fafaf9; font-size: 0.875rem;"
              >
                {t.name}
              </p>
              <p
                class="text-xs"
                style="font-family: 'Outfit', sans-serif; color: #8b8b8a;"
              >
                {t.title}, {t.company}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}
