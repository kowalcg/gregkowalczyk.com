---
/**
 * /skills/<slug>/ — one page per giveaway skill, with a gated download.
 *
 * Rebuilt Sep 2026 as the landing page people reach after the AI for Business
 * meetups: explain what it does in one picture, what you get, the download,
 * a visual install (OS tabs, copy buttons, a folder diagram, a terminal
 * preview), where the files go, then FAQ. Written for owners, not developers;
 * mobile first. Install commands mirror the README inside the zip — keep the
 * two in step with public/downloads/<slug>.zip.
 *
 * The gate is deliberately light: name + email, posted to the same Google
 * Sheet as the contact form (Contact.astro), then the download link is shown
 * on the page. No email round-trip. A localStorage flag skips the form on
 * return visits.
 */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Footer from '../../components/Footer.astro';
import { skills } from '../../data/skills';
import { SITE_URL } from '../../data/site';

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { slug: skill.slug }, props: { skill } }));
}

const { skill } = Astro.props;
const pageUrl = `${SITE_URL}/skills/${skill.slug}/`;
const downloadUrl = `${SITE_URL}${skill.download}`;
const SHEETS_WEBHOOK_URL =
  'https://script.google.com/macros/s/AKfycbyNoyM1DHsnLTBf5wF0Q_YeQjqn2F8H4VALt_LEYqfN7rksZUjZMcoxHiFDc1dhzL95/exec';

const schema = [
  {
    '@type': 'SoftwareSourceCode',
    '@id': `${pageUrl}#skill`,
    name: skill.name,
    description: skill.tagline,
    url: pageUrl,
    codeRepository: downloadUrl,
    programmingLanguage: 'Markdown, Python',
    runtimePlatform: 'Claude Code',
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    version: skill.version,
    datePublished: skill.released,
    author: { '@id': `${SITE_URL}/#person` },
    creator: { '@id': `${SITE_URL}/#person` },
    keywords: 'Claude Code skill, video to guide, transcript, AI for business',
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: `${SITE_URL}/projects/` },
      { '@type': 'ListItem', position: 3, name: skill.name, item: pageUrl },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: skill.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

// Install commands — copied from the README inside the zip.
const MAC_COPY = 'mkdir -p ~/.claude/skills\ncp -R "video-to-skill" ~/.claude/skills/video-to-skill';
const WIN_COPY = 'New-Item -ItemType Directory -Force "$HOME\\.claude\\skills" | Out-Null\nCopy-Item -Recurse "video-to-skill" "$HOME\\.claude\\skills\\video-to-skill"';
const PIP = 'pip3 install youtube-transcript-api markdown';
const RUN = '/video-to-skill https://www.youtube.com/watch?v=…';
const OPTIONAL_MAC = 'brew install ffmpeg yt-dlp\npip3 install openai-whisper';
---

<Layout
  title={`${skill.name} — a free Claude Code skill | Greg Kowalczyk`}
  description={`${skill.tagline} Free download, MIT licence, from Greg Kowalczyk.`}
  extraSchema={schema}
>
  <Nav />
  <main class="sk">
    {/* ── 1. What this is ───────────────────────────────────────────── */}
    <header class="sk-hero">
      <nav aria-label="Breadcrumb" class="sk-crumb">
        <a href="/">Home</a><span>/</span><a href="/projects">Projects</a><span>/</span><b>{skill.name}</b>
      </nav>
      <div class="sk-badges">
        <span class="sk-badge sk-badge-on">Free bonus · AI for Business</span>
        <span class="sk-badge">Claude Code skill</span>
        <span class="sk-badge">v{skill.version} · MIT licence</span>
      </div>
      <h1>Turn any video into a <em>step-by-step guide</em> — and a skill Claude remembers.</h1>
      <p class="sk-lead">Paste a YouTube link, a podcast or a talk. A few minutes later you have a written guide with diagrams you can read, search and share with your team — and, if you want, the expert's method saved as a skill Claude can use on your next job.</p>
      <div class="sk-ctas">
        <a class="sk-btn" href="#download">Get the free skill ↓</a>
        <a class="sk-link" href="#install">How to install it</a>
      </div>
      <ul class="sk-facts">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-clock" /></svg>About 5 minutes to set up</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-dollar" /></svg>No extra cost beyond your Claude plan</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-person" /></svg>No coding needed</li>
      </ul>
    </header>

    {/* ── 2. What it does, in one picture ───────────────────────────── */}
    <section class="sk-sec" aria-labelledby="how-it-works">
      <div class="sk-eyebrow">What it does</div>
      <h2 id="how-it-works">One link in. A guide and a skill out.</h2>
      <ol class="sk-flow">
        <li class="sk-node">
          <div class="sk-ico-row"><svg viewBox="0 0 24 24"><use href="#i-play" /></svg><svg viewBox="0 0 24 24"><use href="#i-mic" /></svg></div>
          <b>1 · You paste a link</b>
          <span>A YouTube video, a podcast, a webinar, a Facebook or Vimeo video, or an audio file on your computer.</span>
        </li>
        <li class="sk-pipe" aria-hidden="true"><i></i></li>
        <li class="sk-node sk-node-hot">
          <div class="sk-ico-row"><svg viewBox="0 0 24 24"><use href="#i-spark" /></svg></div>
          <b>2 · Claude does the homework</b>
          <span>Gets the transcript, looks up the speaker, checks what has changed since the video was made, and finds the steps worth copying.</span>
        </li>
        <li class="sk-pipe" aria-hidden="true"><i></i></li>
        <li class="sk-node">
          <div class="sk-ico-row"><svg viewBox="0 0 24 24"><use href="#i-page" /></svg><svg viewBox="0 0 24 24"><use href="#i-gear" /></svg></div>
          <b>3 · You get the results</b>
          <span>A visual guide you can open in any browser, plus a skill Claude installs so it can use the method from now on.</span>
        </li>
      </ol>
    </section>

    {/* ── 3. What you get + the three ways to run it ─────────────────── */}
    <section class="sk-sec" aria-labelledby="what-you-get">
      <div class="sk-eyebrow">What you get</div>
      <h2 id="what-you-get">Three things land in one folder.</h2>
      <div class="sk-cards">
        <article class="sk-card">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-doc" /></svg>
          <h3>The transcript</h3>
          <p>Every word from the video, saved as text. Taken from YouTube captions, or transcribed on your own computer when there are none.</p>
        </article>
        <article class="sk-card sk-card-hot">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-page" /></svg>
          <h3>A visual guide</h3>
          <p>An 8,000–12,000 word reference with 8–20 diagrams, in one file that works offline. It ends with <b>“Applying this in your business”</b>: the cost of every tool mentioned, and a cheaper alternative.</p>
        </article>
        <article class="sk-card">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-gear" /></svg>
          <h3>A skill Claude keeps</h3>
          <p>The expert's method, written as a Claude skill and installed for you, so next time you ask for help with that kind of work, Claude already knows the method.</p>
        </article>
      </div>

      <h3 class="sk-sub">Pick how much you want each time</h3>
      <div class="sk-modes">
        <div class="sk-mode"><b>Full Skill</b><span>Transcript + guide + skill. For a method you will use again: a sales process, a hiring checklist, a prompt technique.</span><em>Default if you just paste a link</em></div>
        <div class="sk-mode"><b>Guide Only</b><span>Transcript + guide. For training material, SOPs and reference documents.</span></div>
        <div class="sk-mode"><b>Quick Summary</b><span>Key points right in the chat, nothing saved. To see what's in a video before you spend an hour on it.</span></div>
      </div>
    </section>

    {/* ── 4. The download ────────────────────────────────────────────── */}
    <section id="download" class="sk-sec sk-download" data-webhook={SHEETS_WEBHOOK_URL} data-download={skill.download} data-slug={skill.slug} aria-labelledby="get-it">
      <div class="sk-eyebrow">Step 0</div>
      <h2 id="get-it">Get the skill</h2>
      <p>Leave your name and email and the download appears right here. I'll send one follow-up with what people build with it, and an invitation to the next <a href="/meetups">AI for Business meetup</a>. No newsletter, no drip.</p>

      <form id="skill-form" class="sk-form">
        <div class="sk-fields">
          <label for="skill-name">Name<input id="skill-name" name="name" type="text" required autocomplete="name" /></label>
          <label for="skill-email">Email<input id="skill-email" name="email" type="email" required autocomplete="email" /></label>
        </div>
        <div class="sk-hp" aria-hidden="true"><input type="text" id="skill-website" name="website" tabindex="-1" autocomplete="off" /></div>
        <input type="hidden" name="budget" value="Skill download" />
        <input type="hidden" name="message" value={`${skill.name} v${skill.version}`} />
        <button id="skill-submit" type="submit" class="sk-btn">Show me the download</button>
        <p id="skill-status" class="hidden"></p>
      </form>

      <div id="skill-ready" class="hidden sk-ready">
        <a id="skill-download-link" href={skill.download} download class="sk-btn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-download" /></svg>Download {skill.name}.zip ({skill.size})
        </a>
        <p>Saved to your <b>Downloads</b> folder. Double-click the zip to unzip it, then follow the three steps below.</p>
      </div>
    </section>

    {/* ── 5. Install, drawn out ──────────────────────────────────────── */}
    <section id="install" class="sk-sec" aria-labelledby="install-h">
      <div class="sk-eyebrow">Install</div>
      <h2 id="install-h">Three steps, about 5 minutes.</h2>
      <p class="sk-intro">You will type a few lines into the <b>Terminal</b> (Mac) or <b>PowerShell</b> (Windows). Each box below has a copy button — paste, press Enter, done.</p>

      <div class="sk-os" role="tablist" aria-label="Your computer">
        <button type="button" role="tab" aria-selected="true" data-os="mac" id="tab-mac">Mac</button>
        <button type="button" role="tab" aria-selected="false" data-os="win" id="tab-win">Windows</button>
      </div>

      <ol class="sk-steps">
        <li class="sk-step">
          <div class="sk-num">1</div>
          <div class="sk-step-body">
            <h3>Install Claude Code and sign in</h3>
            <p>Get it free from <a href="https://claude.com/claude-code" target="_blank" rel="noopener noreferrer">claude.com/claude-code</a> (it uses your Claude subscription). Then open a terminal, type <code>claude</code>, press Enter and sign in once.</p>
            <p class="sk-os-only" data-for="mac"><b>Open the Terminal:</b> press <kbd>⌘</kbd> + <kbd>Space</kbd>, type <i>Terminal</i>, press Enter.</p>
            <p class="sk-os-only" data-for="win" hidden><b>Open PowerShell:</b> press the <kbd>Windows</kbd> key, type <i>PowerShell</i>, press Enter.</p>
          </div>
        </li>

        <li class="sk-step">
          <div class="sk-num">2</div>
          <div class="sk-step-body">
            <h3>Put the folder where Claude looks for skills</h3>
            <p class="sk-os-only" data-for="mac">First go to your Downloads folder, where the unzipped <b>video-to-skill</b> folder is: type <code>cd ~/Downloads</code> and press Enter. Then paste this:</p>
            <p class="sk-os-only" data-for="win" hidden>Windows' <i>Extract All</i> puts the folder inside a folder of the same name, so first step into the outer one: type <code>cd ~\Downloads\video-to-skill</code> and press Enter. Then paste this:</p>
            <div class="sk-code sk-os-only" data-for="mac"><pre><code>{MAC_COPY}</code></pre><button type="button" class="sk-copy" data-copy={MAC_COPY}>Copy</button></div>
            <div class="sk-code sk-os-only" data-for="win" hidden><pre><code>{WIN_COPY}</code></pre><button type="button" class="sk-copy" data-copy={WIN_COPY}>Copy</button></div>

            <figure class="sk-tree" aria-label="Where the folder must end up">
              <figcaption>It must end up exactly like this:</figcaption>
              <div class="sk-tree-row"><svg viewBox="0 0 24 24"><use href="#i-folder" /></svg><span class="sk-os-only" data-for="mac">Your home folder</span><span class="sk-os-only" data-for="win" hidden>C:\Users\<i>you</i></span></div>
              <div class="sk-tree-row d1"><svg viewBox="0 0 24 24"><use href="#i-folder" /></svg><span>.claude <small>hidden folder</small></span></div>
              <div class="sk-tree-row d2"><svg viewBox="0 0 24 24"><use href="#i-folder" /></svg><span>skills</span></div>
              <div class="sk-tree-row d3 hot"><svg viewBox="0 0 24 24"><use href="#i-folder" /></svg><span><b>video-to-skill</b> <small>← the folder you just copied</small></span></div>
              <div class="sk-tree-row d4"><svg viewBox="0 0 24 24"><use href="#i-doc" /></svg><span>SKILL.md <small>Claude reads this</small></span></div>
              <p class="sk-tip sk-os-only" data-for="mac">Want to see it in Finder? The <b>.claude</b> folder is hidden: in your home folder press <kbd>⌘</kbd> + <kbd>Shift</kbd> + <kbd>.</kbd> to show hidden folders.</p>
              <p class="sk-tip sk-os-only" data-for="win" hidden>Want to see it in File Explorer? Paste <code>%USERPROFILE%\.claude\skills</code> into the address bar.</p>
            </figure>
          </div>
        </li>

        <li class="sk-step">
          <div class="sk-num">3</div>
          <div class="sk-step-body">
            <h3>Add two small helpers</h3>
            <p>The skill uses Python to fetch transcripts and build the guide. Claude will offer to install these the first time it needs them — or do it now:</p>
            <div class="sk-code"><pre><code>{PIP}</code></pre><button type="button" class="sk-copy" data-copy={PIP}>Copy</button></div>
            <details class="sk-more">
              <summary>Optional: podcasts, audio files and videos without captions</summary>
              <p>These let it transcribe audio on your own computer (free, no account needed).</p>
              <div class="sk-code sk-os-only" data-for="mac"><pre><code>{OPTIONAL_MAC}</code></pre><button type="button" class="sk-copy" data-copy={OPTIONAL_MAC}>Copy</button></div>
              <p class="sk-os-only" data-for="win" hidden>Install <a href="https://ffmpeg.org" target="_blank" rel="noopener noreferrer">ffmpeg</a> and <a href="https://github.com/yt-dlp/yt-dlp" target="_blank" rel="noopener noreferrer">yt-dlp</a>, then run <code>pip3 install openai-whisper</code>.</p>
            </details>
          </div>
        </li>
      </ol>

      {/* ── Use it: a terminal preview ── */}
      <div class="sk-use">
        <div>
          <div class="sk-eyebrow">Use it</div>
          <h3 class="sk-use-h">Now try it.</h3>
          <p>Close and reopen Claude Code (type <code>claude</code>), then type this with any YouTube link. Or just say <i>“learn from this video”</i> and paste the link.</p>
          <div class="sk-code"><pre><code>{RUN}</code></pre><button type="button" class="sk-copy" data-copy="/video-to-skill ">Copy</button></div>
        </div>
        <figure class="sk-term" aria-label="What you will see in the terminal">
          <div class="sk-term-bar"><i></i><i></i><i></i><span>claude</span></div>
          <div class="sk-term-body">
            <p class="t1"><span class="p">&gt;</span> /video-to-skill https://youtube.com/watch?v=…</p>
            <p class="t2">What do you need from this video?</p>
            <p class="t3"><b>1</b> Full Skill — guide + a skill I keep</p>
            <p class="t4"><b>2</b> Guide Only — the visual guide</p>
            <p class="t5"><b>3</b> Quick Summary — key points here</p>
            <p class="t6"><span class="p">&gt;</span> 1</p>
            <p class="t7 ok">✓ Transcript saved</p>
            <p class="t8 ok">✓ Guide written — 14 diagrams checked</p>
            <p class="t9 ok">✓ Skill installed</p>
          </div>
        </figure>
      </div>
    </section>

    {/* ── 6. Where your files go ─────────────────────────────────────── */}
    <section class="sk-sec" aria-labelledby="files-h">
      <div class="sk-eyebrow">Where your files go</div>
      <h2 id="files-h">Everything in one place: Downloads › Video Skills.</h2>
      <div class="sk-files">
        <figure class="sk-tree">
          <div class="sk-tree-row"><svg viewBox="0 0 24 24"><use href="#i-folder" /></svg><span>Downloads</span></div>
          <div class="sk-tree-row d1"><svg viewBox="0 0 24 24"><use href="#i-folder" /></svg><span>Video Skills</span></div>
          <div class="sk-tree-row d2 hot"><svg viewBox="0 0 24 24"><use href="#i-folder" /></svg><span><b>one folder per video</b></span></div>
          <div class="sk-tree-row d3"><svg viewBox="0 0 24 24"><use href="#i-doc" /></svg><span>transcript.txt</span></div>
          <div class="sk-tree-row d3"><svg viewBox="0 0 24 24"><use href="#i-page" /></svg><span>…-guide.html <small>open this one</small></span></div>
          <div class="sk-tree-row d3"><svg viewBox="0 0 24 24"><use href="#i-doc" /></svg><span>…-guide.md</span></div>
          <div class="sk-tree-row d3"><svg viewBox="0 0 24 24"><use href="#i-gear" /></svg><span>SKILL.md <small>Full Skill only</small></span></div>
        </figure>
        <p>Nothing else on your computer is touched. In Full Skill mode Claude tells you before it installs the new skill, so you stay in charge.</p>
      </div>
    </section>

    {/* ── 7. Why + FAQ ───────────────────────────────────────────────── */}
    <section class="sk-sec sk-why" aria-labelledby="why-h">
      <h2 id="why-h">Why I'm giving it away</h2>
      <p>This is the skill I use to learn. A useful talk goes in, and a reference document I can search, share with my team and act on comes out, with the method captured as a skill Claude applies the next time I need it. It has replaced hours of note-taking for me, and it is the clearest demonstration I have of what a Claude Code skill is: a plain text file that turns a repeatable job into one command.</p>
      <p>{skill.origin}. If you make it better, tell me. If you want the same idea built for a job specific to your business, that is <a href="/services">what I do</a>.</p>
    </section>

    <section class="sk-sec" aria-labelledby="skill-faq">
      <h2 id="skill-faq">Questions</h2>
      <div class="sk-faq">
        {skill.faq.map(({ q, a }) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <p class="sk-back"><a href="/projects">← All projects and skills</a></p>
    </section>

    <ContactCTA
      heading="Want a skill built for your business?"
      body="Every repeatable job in a business can become one command. Tell me which one eats your week."
    />
  </main>
  <Footer />

  <script>
    // ── Download gate (unchanged behaviour) ──
    const section = document.getElementById('download');
    const form = document.getElementById('skill-form') as HTMLFormElement | null;
    const ready = document.getElementById('skill-ready');
    const submitBtn = document.getElementById('skill-submit') as HTMLButtonElement | null;
    const status = document.getElementById('skill-status');
    const slug = section?.dataset.slug ?? 'skill';
    const storageKey = `skill-unlocked:${slug}`;

    function reveal() {
      form?.classList.add('hidden');
      ready?.classList.remove('hidden');
    }
    try { if (localStorage.getItem(storageKey)) reveal(); } catch { /* storage unavailable; show the form */ }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !section) return;
      const honeypot = (form.querySelector('#skill-website') as HTMLInputElement | null)?.value;
      if (honeypot) { reveal(); return; }
      submitBtn.disabled = true;
      submitBtn.textContent = 'One second…';
      try {
        const params = new URLSearchParams();
        for (const [key, value] of new FormData(form).entries()) params.append(key, String(value));
        params.append('company', 'skill download');
        params.append('pageUrl', window.location.href);
        await fetch(section.dataset.webhook ?? '', { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() });
      } catch { /* the sheet write failed; still hand over the file */ } finally {
        try { localStorage.setItem(storageKey, '1'); } catch { /* ignore */ }
        reveal();
        if (status) status.classList.add('hidden');
      }
    });

    // ── Mac / Windows tabs (remembered; Windows preselected on Windows) ──
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.sk-os [data-os]')];
    function showOS(os: string) {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.os === os)));
      document.querySelectorAll<HTMLElement>('.sk-os-only').forEach((el) => { el.hidden = el.dataset.for !== os; });
      try { localStorage.setItem('sk-os', os); } catch { /* ignore */ }
    }
    let os = /Win/i.test(navigator.userAgent) ? 'win' : 'mac';
    try { os = localStorage.getItem('sk-os') || os; } catch { /* ignore */ }
    showOS(os);
    tabs.forEach((t) => t.addEventListener('click', () => showOS(t.dataset.os!)));

    // ── Copy buttons ──
    document.querySelectorAll<HTMLButtonElement>('.sk-copy').forEach((b) => b.addEventListener('click', async () => {
      const text = b.dataset.copy || '';
      try { await navigator.clipboard.writeText(text); b.textContent = 'Copied ✓'; }
      catch {
        const pre = b.parentElement?.querySelector('pre');
        if (pre) { const r = document.createRange(); r.selectNodeContents(pre); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); }
        b.textContent = 'Selected — copy it';
      }
      setTimeout(() => { b.textContent = 'Copy'; }, 1800);
    }));

    // ── Terminal preview types itself once it scrolls into view ──
    const term = document.querySelector('.sk-term');
    if (term) new IntersectionObserver(([e], io) => { if (e.isIntersecting) { term.classList.add('play'); io.disconnect(); } }, { threshold: 0.4 }).observe(term);
  </script>
</Layout>

<style>
  .sk { --w: 62rem; }
  .sk-hero, .sk-sec { max-width: var(--w); margin: 0 auto; padding-inline: 1.25rem; }
  .sk-hero { padding-top: 3rem; padding-bottom: 2rem; }
  .sk-sec { padding-top: 3.5rem; padding-bottom: 1rem; scroll-margin-top: 72px; }
  .sk-crumb { font-family: var(--font-mono); font-size: 12.5px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .sk-crumb a:hover { color: var(--fg); }
  .sk-crumb b { color: var(--fg); font-weight: 500; }
  .sk-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .sk-badge { font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; padding: 6px 11px; border-radius: 999px; border: 1px solid var(--rule-strong); color: var(--muted); }
  .sk-badge-on { background: var(--color-accent-fill); color: var(--on-accent); border-color: var(--accent); font-weight: 700; }
  .sk h1 { font-family: var(--font-body); font-weight: 800; font-size: clamp(34px, 5.6vw, 64px); line-height: 1.02; letter-spacing: -.03em; margin: 0 0 18px; text-wrap: balance; }
