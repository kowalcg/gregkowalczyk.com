---
/**
 * /projects/<slug>/ — per-project build story.
 *
 * Only projects with a markdown body get a page. These exist to serve the
 * proof-of-work long tail identified in docs/keyword-strategy.md — queries like
 * "how to build an ios app without coding" or "mcp server for amazon sellers",
 * where first-hand evidence beats a directory listing.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects
    .filter((p) => (p.body ?? '').trim().length > 0)
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const pageUrl = `${SITE_URL}/projects/${project.slug}/`;

const schema: Record<string, unknown> = {
  '@type': d.schemaType,
  '@id': `${pageUrl}#project`,
  name: d.name,
  description: d.description,
  // For a live site/app the entity's url is the thing itself; this page is where it is described.
  url: d.liveUrl ?? pageUrl,
  mainEntityOfPage: pageUrl,
  ...(d.liveUrl ? { sameAs: [d.liveUrl] } : {}),
  ...(d.image ? { image: new URL(d.image, SITE_URL).href } : {}),
  ...(d.year ? { datePublished: d.year } : {}),
  ...(d.schemaType === 'SoftwareApplication'
    ? {
        applicationCategory: 'BusinessApplication',
        ...(d.platform ? { operatingSystem: d.platform } : {}),
      }
    : {}),
  creator: { '@id': `${SITE_URL}/#person` },
  ...(d.schemaType === 'WebSite' ? { publisher: { '@id': `${SITE_URL}/#person` } } : {}),
  ...(d.tech.length ? { keywords: d.tech.join(', ') } : {}),
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${SITE_URL}/projects/` },
    { '@type': 'ListItem', position: 3, name: d.name, item: pageUrl },
  ],
};

// FAQPage only where the FAQ is visible — the same array renders the section below.
const faqSchema = d.faq?.length
  ? {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: d.faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    }
  : null;

const extraSchema = faqSchema ? [schema, breadcrumbSchema, faqSchema] : [schema, breadcrumbSchema];
---

<Layout
  title={`${d.name} | Built by Greg Kowalczyk`}
  description={d.description}
  ogImage={d.image}
  extraSchema={extraSchema}
>
  <Nav />
  <main>
    <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
      <header class="mb-10">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm" style="font-family: 'JetBrains Mono', monospace; color: var(--muted);">
          <a href="/" class="hover:text-[var(--fg)]">Home</a>
          <span class="mx-2">/</span>
          <a href="/projects" class="hover:text-[var(--fg)]">Projects</a>
          <span class="mx-2">/</span>
          <span style="color: var(--fg);">{d.name}</span>
        </nav>
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <span
            class="rounded-full px-3 py-1 text-xs"
            style={`font-family: 'JetBrains Mono', monospace; background: ${
              d.tagColor === 'purple' ? 'rgba(240, 96, 0, 0.1)' : 'rgba(240, 96, 0, 0.1)'
            }; color: ${d.tagColor === 'purple' ? '#f06000' : '#f06000'};`}
          >
            {d.tag}
          </span>
          {d.year && (
            <span class="text-sm" style="font-family: 'JetBrains Mono', monospace; color: var(--muted);">
              {d.year}
            </span>
          )}
        </div>

        <h1
          class="mb-5 text-3xl font-bold md:text-4xl lg:text-5xl"
          style="font-family: 'Outfit', sans-serif; letter-spacing: -0.025em;"
        >
          <span class="gradient-text">{d.name}</span>
        </h1>

        <p class="text-lg leading-relaxed" style="font-family: 'Outfit', sans-serif; color: var(--muted);">
          {d.description}
        </p>
      </header>

      {d.image && (
        <div
          class="mb-12 overflow-hidden rounded-2xl"
          style="border: 1px solid color-mix(in srgb, var(--fg) 10%, transparent); box-shadow: 0 8px 32px color-mix(in srgb, var(--bg) 40%, transparent);"
        >
          <img src={d.image} alt={`${d.name} screenshot`} class="w-full" loading="lazy" />
        </div>
      )}

      {d.stats.length > 0 && (
        <div class="glass-card mb-12 p-8">
          <ul class="space-y-3" style="font-family: 'Outfit', sans-serif; color: var(--muted);">
            {d.stats.map((stat) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-2 block h-1.5 w-1.5 flex-shrink-0 rounded-full"
                  style="background-color: #f06000;"
                ></span>
                <span>{stat}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="prose-blog">
        <Content />
      </div>

      {d.faq && d.faq.length > 0 && (
        <section class="mt-14" aria-labelledby="project-faq">
          <h2
            id="project-faq"
            class="mb-6 text-2xl font-bold"
            style="font-family: 'Outfit', sans-serif; letter-spacing: -0.02em; color: var(--fg);"
          >
            Frequently asked questions
          </h2>
          <div class="space-y-4">
            {d.faq.map(({ q, a }) => (
              <details class="glass-card p-6">
                <summary
                  class="cursor-pointer text-base font-semibold"
                  style="font-family: 'Outfit', sans-serif; color: var(--fg);"
                >
                  {q}
                </summary>
                <p class="mt-3 leading-relaxed" style="font-family: 'Outfit', sans-serif; color: var(--muted);">
                  {a}
                </p>
              </details>
            ))}
          </div>
        </section>
      )}

      {d.tech.length > 0 && (
        <div class="mt-12 flex flex-wrap gap-2">
          {d.tech.map((t) => (
            <span
              class="rounded-full px-3 py-1 text-xs"
              style="font-family: 'JetBrains Mono', monospace; background: color-mix(in srgb, var(--fg) 5%, transparent); color: var(--muted); border: 1px solid color-mix(in srgb, var(--fg) 8%, transparent);"
            >
              {t}
            </span>
          ))}
        </div>
      )}

      {d.links.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-3">
          {d.links.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="rounded-full px-5 py-2 text-sm font-semibold transition-all duration-200 hover:scale-105"
              style="background: color-mix(in srgb, var(--fg) 6%, transparent); color: var(--fg); border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); font-family: 'Outfit', sans-serif;"
            >
              {link.label} {link.external ? '↗' : '→'}
            </a>
          ))}
        </div>
      )}

      <p class="mt-12">
        <a
          href="/projects"
          class="text-sm transition-colors duration-200 hover:text-[var(--fg)]"
          style="font-family: 'Outfit', sans-serif; color: var(--muted);"
        >
          ← All projects
        </a>
      </p>
    </article>

    <ContactCTA />
  </main>
  <Footer />
</Layout>
