---
interface Props {
  title: string;
  description: string;
  ogType?: string;
  ogImage?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  /** Emit the FAQPage node. Only set this on pages that visibly render <FAQ />. */
  showFaq?: boolean;
  /** Page-specific JSON-LD nodes (BlogPosting, PodcastEpisode, etc.) appended to the @graph. */
  extraSchema?: Record<string, unknown>[];
}

import '../styles/global.css';
import { faqs } from '../data/faqs';
import { yearsInEngineering } from '../data/site';
import { appearances, mediaSameAs, slugify } from '../data/media';
import Analytics from '../components/Analytics.astro';

const {
  title,
  description,
  ogType,
  ogImage,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  showFaq = false,
  extraSchema = [],
} = Astro.props;

/**
 * Canonical host. Every schema @id, url, and social image must use this exact
 * origin — mixing apex and www splits the entity across two URLs in Google's
 * index, which is what was happening before July 2026.
 */
const SITE = "https://www.gregkowalczyk.com";
const canonicalURL = new URL(Astro.url.pathname, SITE);
const socialImage = new URL(ogImage ?? "/images/og-default.jpg", SITE).href;

const graph: Record<string, unknown>[] = [
    {
      "@type": "Person",
      "@id": `${SITE}/#person`,
      "name": "Greg Kowalczyk",
      "jobTitle": "Business Growth Engineer",
      "description": `Mechanical engineer turned e-commerce operator. ${yearsInEngineering} years in engineering (1997–2019), two e-commerce brands run since 2014. Grows small and mid-size businesses with engineering discipline — find the constraint, fix it, automate it — using AI systems tested on his own brands first.`,
      "url": SITE,
      "image": `${SITE}/images/greg-headshot.jpg`,
      "email": "prekoconsult@gmail.com",
      "telephone": "+1-905-334-9282",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Oakville",
        "addressRegion": "ON",
        "addressCountry": "CA"
      },
      "knowsAbout": [
        "Artificial Intelligence Implementation",
        "AI Automation for Business",
        "Custom AI Tool Development",
        "Model Context Protocol (MCP)",
        "E-commerce Operations",
        "AI Consultant Oakville",
        "AI Consulting Oakville",
        "AI Implementation Consultant GTA",
        "Product Launch Content Orchestration",
        "Custom AI Tools for Small Business",
        "Claude AI",
        "Workflow Automation",
        "Amazon FBA",
        "Shopify Development",
        "Marketing Automation",
        "Answer Engine Optimization",
        "Mechanical Engineering"
      ],
      /**
       * sameAs is the entity-disambiguation signal. "Greg Kowalczyk" is a
       * contested SERP — two obituaries for a different Gregory Kowalczyk and
       * several namesakes rank above this site — so every verifiable
       * third-party profile and media appearance is listed as corroboration.
       */
      "sameAs": [
        "https://www.linkedin.com/in/gregkowalczyk/",
        "https://x.com/kowalcg",
        "https://www.facebook.com/Kowalcg/",
        "https://github.com/kowalcg",
        ...mediaSameAs,
      ],
      "subjectOf": appearances.map((m) => ({
        "@id": `${SITE}/media/#${slugify(m.title)}`,
      })),
      "worksFor": [
        {
          "@type": "Organization",
          "name": "TapeGeeks Inc.",
          "url": "https://tapegeeks.com"
        },
        {
          "@type": "Organization",
          "name": "GearTOP Inc.",
          "url": "https://geartopdesign.com"
        }
      ]
    },
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#service`,
      "name": "Greg Kowalczyk — Business Growth Consulting & AI Implementation",
      "description": "Business growth consulting for small and mid-size businesses, built on engineering discipline: find the constraint, fix it, automate it. Custom AI tools and automation you own outright.",
      "url": SITE,
      "provider": { "@id": `${SITE}/#person` },
      "areaServed": [
        {
          "@type": "City",
          "name": "Oakville",
          "containedInPlace": { "@type": "AdministrativeArea", "name": "Ontario" }
        },
        {
          "@type": "City",
          "name": "Burlington",
          "containedInPlace": { "@type": "AdministrativeArea", "name": "Ontario" }
        },
        {
          "@type": "City",
          "name": "Toronto",
          "containedInPlace": { "@type": "AdministrativeArea", "name": "Ontario" }
        },
        {
          "@type": "Place",
          "name": "Greater Toronto Area (GTA)"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Ontario",
          "containedInPlace": { "@type": "Country", "name": "Canada" }
        }
      ],
      "serviceType": [
        "AI Implementation Consulting",
        "AI Consulting Oakville",
        "Custom AI Tool Development",
        "Custom AI Tools for Small Business",
        "Product Launch Content Orchestration",
        "Business Process Automation",
        "AI Readiness Assessment",
        "Marketing Automation",
        "E-commerce AI Integration",
        "Workflow Automation with N8N and Zapier",
        "AI Strategy and Deployment",
        "E-Commerce Launch Consulting",
        "Amazon and Shopify Setup and Optimization",
        "Local SEO and Google Business Profile Optimization",
        "Answer Engine Optimization for LLM Search",
        "Brick-and-Mortar to E-Commerce Transition"
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": `${SITE}/#business`,
      "name": "Greg Kowalczyk — Business Growth Engineer",
      "description": "Oakville-based AI implementation specialist serving the GTA. Custom AI tools and automation built, deployed, and running in weeks.",
      "url": SITE,
      "telephone": "+1-905-334-9282",
      "email": "prekoconsult@gmail.com",
      "founder": { "@id": `${SITE}/#person` },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Oakville",
        "addressRegion": "ON",
        "postalCode": "L7R",
        "addressCountry": "CA"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.3255,
        "longitude": -79.7990
      },
      "priceRange": "$$",
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "17:00"
      }
    },
];

/**
 * FAQPage is only valid on pages that visibly render the FAQ. It used to be
 * emitted on every URL — including /contact/, /projects/ and all blog posts —
 * which violates Google's structured data guidelines. Questions are generated
 * from src/data/faqs.ts so the markup always matches the accordion.
 */
if (showFaq) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${canonicalURL.href}#faq`,
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
    })),
  });
}

graph.push(...extraSchema);

const structuredData = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Google Fonts (preconnect + non-blocking load) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Title & Description -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Favicons. apple-touch-icon was missing entirely, so iOS home-screen
         saves fell back to a screenshot of the page. theme-color tints the
         browser chrome on Android and iOS Safari to match the ground. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Greg Kowalczyk — News"
      href={new URL("/rss.xml", SITE).href}
    />

    <!-- Open Graph (image must be absolute — relative URLs are ignored by most scrapers) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content={ogType ?? "website"} />
    <meta property="og:site_name" content="Greg Kowalczyk — Business Growth Engineer" />
    <meta property="og:image" content={socialImage} />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <Analytics />
  </head>

  <body class="noise-overlay min-h-screen bg-bg-primary text-text-primary font-body antialiased">
    <!-- Floating gradient orbs for glass refraction depth -->
    <div class="orb orb-purple" aria-hidden="true"></div>
    <div class="orb orb-blue" aria-hidden="true"></div>
    <div class="orb orb-cyan" aria-hidden="true"></div>

    <slot />
  </body>
</html>
